        "filter_brain": "记忆与逻辑", 
        "filter_sport": "体能训练", 
        "filter_tools": "工具",
        "help_desc": "描述", 
        "help_setup": "设置", 
        "help_example": "示例",
        "g_counter": "简单计数器", "g_timer": "简单计时器", "g_stopwatch": "秒表", "g_countdown": "倒计时",
        "g_shuttle": "折返跑", "g_simon": "西蒙说", "g_simonruns": "西蒙跑", "g_zombie": "僵尸逃生",
        "g_whac": "打地鼠", "g_sorting": "分院帽", "g_bomb": "拆弹部队", "g_redgreen": "一二三木头人",
        "g_beep": "Luc Léger (折返跑测试)", "g_react2p": "双人反应", "g_target": "目标触摸", "g_ball": "运球",
        "g_ttest": "T型敏捷测试", "g_hunt": "狩猎！", "g_pacemaker": "配速员", "g_memory": "记忆冲刺",
        "g_domination": "占领", "g_batak": "Batak Pro", "g_tabata": "Tabata 计时器", "g_display": "显示模式", "g_settings": "设置",

        "desc_stopwatch": "一个简单的秒表。每个 puck 作为独立的秒表。教练可以通过“统一 START”同时启动所有 pucks。包含带防抢跑检测的“长按 + 倒计时”模式。<br><b>计圈模式：</b>点击记录一圈。双击或长按 (0.5秒) 停止计时。", 
        "setup_stopwatch": "选择玩家人数和模式。", 
        "ex_stopwatch": "例如：3名玩家，无其他设置。每个 puck 是一个秒表。按第1次 = START，第2次 = STOP。", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "实用的教学工具。每个 puck 作为学生的个人倒计时器。", 
        "setup_timer": "设置基础时间。Pucks 会亮起，光环像沙漏一样减少。学生完成任务后按下自己的 puck。你可以立刻看到谁完成了。", 
        "ex_timer": "非常适合循环训练、静音任务或词汇测试。", 
        "img_timer": "",
        
        "desc_countdown": "从一个数字开始倒数到零。通过 LED 环进行可视化。与其说是游戏，不如说是训练工具。", 
        "setup_countdown": "选择起始数字 (1-100)。选项：在第一名获胜者出现时停止。", 
        "ex_countdown": "设置为30。谁能最先完成30个俯卧撑（每次按下 puck）？", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "终极反应和认知训练。Pucks 随机亮起。找到正确颜色，忽略错误颜色！", 
        "setup_whac": "最多3个组。定义游戏颜色并选择有效目标。5个难度级别。", 
        "ex_whac": "级别 4：Pucks 亮起，但颜色每 1.5 秒轮换一次！保持专注。", 
        "img_whac": "",
        
        "desc_counter": "训练辅助工具。只计算玩家按下 puck 的次数。（每次输入之间至少 0.3 秒！）", 
        "setup_counter": "每位玩家 1 个 Puck。时间限制可调。", 
        "ex_counter": "孩子做完一个动作，跑过去按下 puck 并重复。3分钟后谁的分数最高？", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "经典的耐力测试。在起点和目标之间来回跑动。", 
        "setup_shuttle": "每位玩家 2 个 Pucks。起点 puck 显示跑动灯效，目标 puck 呼吸闪烁。起点：按住 pucks 直到 GO 信号亮起！防抢跑检测已激活。", 
        "ex_shuttle": "按住起点 -> \"GO\" -> 跑向目标并按下 -> 跑回起点并按下。", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "记住颜色图案！电脑展示，你来重复。", 
        "setup_simon": "最多支持3个组同时进行。选择每组的 pucks。每个 puck 都有颜色。序列长度可调。", 
        "ex_simon": "红色闪烁 -> 按下红色。第2回合：红色、蓝色闪烁 -> 按下红色、蓝色...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "记住图案！跑向 pucks 并按下它们。<br><b>特殊：团队模式</b><br>只有一个显示 puck，所有组解答相同的序列。", 
        "setup_simonruns": "最多3个组。每个 puck 都有颜色。序列长度可调。", 
        "ex_simonruns": "红色闪烁 -> 跑向红色，按下！跑回显示器...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "不断缩短时间限制的重复冲刺。如果未能及时到达，你将被淘汰 (被咬)！", 
        "setup_zombie": "设置起始时间 (例如 10秒) 和每回合减少的时间 (例如 0.5秒)。<br><b>自动减少：</b>成功冲刺后时间自动减少。<br><b>突然死亡：</b>失败一次 = 淘汰。", 
        "ex_zombie": "按住起点 -> \"GO\" -> 跑向目标。下一回合：你的时间变少了！", 
        "img_zombie": "",
        
        "desc_beep": "经典的耐力测试。跟着信号节奏跑 20 米。速度每分钟递增。可计算 VO²max。", 
        "setup_beep": "注意：起点和目标之间的距离必须正好是 20米。选择玩家人数。", 
        "ex_beep": "听到信号 -> 跑向目标并等待。太早/太晚 = 黄牌。第二张黄牌 = 淘汰！", 
        "img_beep": "",
        
        "desc_tabata": "团队训练的视觉和听觉控制器。教练不再需要手拿秒表。", 
        "setup_tabata": "将 pucks 放在站点。设置 WORK 和 REST 时间。切换前 3 秒发出蜂鸣声。", 
        "ex_tabata": "20秒 Work, 10秒 Rest。绿色光环逐渐减少。在剩 3 秒时：滴.. 滴.. 滴。然后显示红色呼吸灯进行 10 秒休息。", 
        "img_tabata": "",
        
        "desc_react2p": "终极对决！两名玩家面对面。先击中你的颜色即可得分。", 
        "setup_react2p": "选择时间和 pucks 数量 (至少 3 个)。通过添加干扰色来增加难度。", 
        "ex_react2p": "P1 找红色，P2 找蓝色。Pucks 亮起 -> 尽快击中你的颜色！", 
        "img_react2p": "",
        
        "desc_domination": "高强度耐力游戏。两支队伍争夺场地控制权。占领并偷取 pucks！", 
        "setup_domination": "将 pucks 散布在场地上。队伍 1 点击 1次 占领。队伍 2 双击 偷取。", 
        "ex_domination": "队伍 1 跑动并点击 (变成红色)。队伍 2 追逐并双击 (变成蓝色)。2 分钟后谁的 puck 更多？", 
        "img_domination": "",
        
        "desc_target": "训练核心稳定性和反应时间。仰卧起坐或平板支撑的完美助手。", 
        "setup_target": "仰卧起坐：将 pucks 固定在墙上。每次仰卧起坐按下一个亮起的 puck。设置 2-3 秒的暂停延迟以便躺下。<br>平板支撑：将 3 个 pucks 呈半圆形摆放。亮起时抬起一只手按下。", 
        "ex_target": "选择时间模式 (例如坚持 60秒) 或回合模式 (例如完成 30个仰卧起坐)。", 
        "img_target": "",
        
        "desc_ball": "运球运动训练。将 pucks 作为站点 (例如正方形)。", 
        "setup_ball": "选择每个站点的 pucks 数量。玩家运球到亮起的自己颜色的 puck 处。", 
        "ex_ball": "设置4个 pucks 成正方形。一个 puck 亮起 -> 运球过去按下，下一个亮起。", 
        "img_ball": "",
        
        "desc_batak": "类似 F1 赛车的反应和周边视觉训练。手眼协调的压力测试。", 
        "setup_batak": "将 pucks 较宽地固定在墙上。它们会随机短暂亮起。在熄灭前击中它们！", 
        "ex_batak": "在墙上固定 12 个 pucks。设置 60 秒和“中等”。Pucks 亮起并在 1.2 秒后消失。", 
        "img_batak": "",
        
        "desc_ttest": "敏捷性全球标准测试。时间压力下的冲刺和变向。", 
        "setup_ttest": "设置：将 4 个 pucks 摆成 T 形。<br>1/4 环：起点 (A)<br>2/4 环：中心 (B, 距 A 10米)<br>3/4 环：左侧 (C, 距 B 5米)<br>4/4 环：右侧 (D, 距 C 10米)", 
        "ex_ttest": "从 A 冲刺到 B -> 侧步到 C -> 侧步到 D -> 侧步回 B -> 倒退跑回 A。", 
        "img_ttest": "",
        
        "desc_sorting": "将一大群玩家公平地分成人数相等的队伍。", 
        "setup_sorting": "选择学院 (队伍) 数量、总玩家人数以及有多少个 pucks 作为“分院帽”。", 
        "ex_sorting": "20 名学生，4 个学院。算法保证每个学院正好 5 名学生。", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "滴答... 滴答... 你能估算时间吗？在最准确的时刻拆除炸弹！", 
        "setup_bomb": "选择时间 (例如 5秒)、难度 (容错率) 和回合数。", 
        "ex_bomb": "Puck 闪烁 5 次 (=5秒)。然后倒计时。然后静音。恰好在 5 秒后按下！绿色 = 拆除，红色 = BOOM。", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "大脑慢跑！在体力负荷下训练空间工作记忆 (双重任务)。", 
        "setup_memory": "将 pucks 散布在广阔区域。Pucks 显示颜色对，然后变成中性。找到并按下匹配的颜色对！<br><b>搜索模式：</b>初始不显示颜色。", 
        "ex_memory": "跑向中性 puck 并按下 -> 变成红色。记住另一个红色 puck 在哪里。配对 = 绿色！", 
        "img_memory": "",
        
        "desc_redgreen": "经典游戏！绿色 = 跑，红色 = 停。在绿色时到达 puck 得分。红色时按下会被罚分。", 
        "setup_redgreen": "选择组数。每组有自己的节奏。", 
        "ex_redgreen": "绿色 -> 快跑！红色 -> 立即停止！只在绿色时按下。", 
        "img_redgreen": "",
        
        "desc_pacemaker": "完美的配速！Pucks 就像虚拟的“兔子”，指示准确的跑步速度。", 
        "setup_pacemaker": "将 pucks 放置在固定距离 (例如 10米)。在你需要到达的 1 秒前光亮减弱。不要按下，只需专注跑步！", 
        "ex_pacemaker": "设置为 5:00 分钟/公里。恰好在灯光熄灭时到达 puck！", 
        "img_pacemaker": "",
        
        "desc_hunt": "在圆圈中狩猎你的颜色！认知和快速方向改变。", 
        "setup_hunt": "将至少 3 个 pucks 围成一圈。你的颜色亮起 -> 击中它 -> 立即亮起新的。", 
        "ex_hunt": "左后方红色亮起 -> 冲刺并按下！谁能在 60 秒内抓到最多？", 
        "img_hunt": "",
        
        "desc_display": "简单的显示模式，用于控制所有 pucks 并播放视觉特效。", 
        "setup_display": "Pucks 可以单独控制，也可以统一控制。", 
        "ex_display": "吸引眼球。孩子们喜欢闪烁的灯光！", 
        "img_display": "game_display.jpg",

