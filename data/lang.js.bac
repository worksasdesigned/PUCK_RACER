	"fr": {
        "btn_back": "⬅ RETOUR",
        "btn_next": "SUIVANT ➡",
        "btn_cancel": "Annuler",
        "btn_start_game": "START JEU 🏁",
        "btn_start": "START",
        "btn_stop": "STOP",
        "btn_reset": "RESET",
        "btn_home": "🏠 Accueil",
        "btn_running": "En cours...",
        "btn_start_all": "TOUT START",
        "btn_stop_all": "TOUT STOP",
        "lbl_time_limit": "Limite Temps:",
        "loading": "Chargement...",
        "loading_pucks": "Chargement Pucks...",
        "conn_pucks": "Pucks connectés:",
        "req_pucks": "Requis:",
        "lbl_done": "FINI",
		"filter_fav": "⭐ Favoris",
        
        "filter_all": "Tous les jeux", 
        "filter_reaction": "Réaction", 
        "filter_brain": "Mémoire & Logique", 
        "filter_sport": "Entraînement", 
        "filter_tools": "Outils",
        "help_desc": "Description", 
        "help_setup": "Configuration", 
        "help_example": "Exemple",
        "g_counter": "Compteur simple", "g_timer": "Minuteur simple", "g_stopwatch": "Chronomètre", "g_countdown": "Compte à rebours",
        "g_shuttle": "Shuttle Run", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "Zombie Escape",
        "g_whac": "Whac-A-Mole", "g_sorting": "Le Choixpeau", "g_bomb": "Démineur", "g_redgreen": "1, 2, 3, Soleil",
        "g_beep": "Luc Léger (Test Navette)", "g_react2p": "Réaction 2 Joueurs", "g_target": "Target Touch", "g_ball": "Dribble Ballon",
        "g_ttest": "Agility T-Test", "g_hunt": "Hunt!", "g_pacemaker": "Le Pacemaker", "g_memory": "Memory Sprint",
        "g_domination": "Domination", "g_batak": "Batak Pro", "g_tabata": "Tabata Timer", "g_display": "Mode Affichage", "g_settings": "Paramètres",

        "desc_stopwatch": "Un simple chronomètre. Chaque puck sert de chrono indépendant. L'entraîneur peut tout lancer via \"START Central\". Mode \"Maintenir + Compte à rebours\" avec détection de faux départ.<br><b>Mode Tour :</b> Un clic enregistre un tour. Un double-clic ou un maintien (0.5s) arrête le temps.", 
        "setup_stopwatch": "Choisir le nombre de joueurs et le mode.", 
        "ex_stopwatch": "Ex : 3 joueurs, sans autres réglages. Chaque puck est un chrono. 1er appui = START, 2ème = STOP.", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "Outil pratique pour l'enseignement. Chaque puck sert de compte à rebours personnel pour un élève.", 
        "setup_timer": "Définir le temps de base. Les pucks s'allument et le cercle se vide comme un sablier. Quand un élève a fini, il appuie sur son puck. Vous voyez immédiatement qui a terminé.", 
        "ex_timer": "Idéal pour le circuit training, le travail en silence ou les tests de vocabulaire.", 
        "img_timer": "",
        
        "desc_countdown": "Démarre à un nombre et compte à rebours jusqu'à zéro. Visualisé via l'anneau LED. Plus un outil d'entraînement qu'un jeu.", 
        "setup_countdown": "Choisir le nombre de départ (1-100). Option : Arrêt au premier gagnant.", 
        "ex_countdown": "Réglé sur 30. Qui peut faire 30 pompes en premier (en appuyant sur le puck à chaque fois) ?", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "L'exercice ultime de réaction et de cognition. Les pucks s'allument aléatoirement. Trouvez les bonnes couleurs et ignorez les mauvaises !", 
        "setup_whac": "Jusqu'à 3 groupes. Définir les couleurs du jeu et choisir les cibles valides. 5 niveaux de difficulté.", 
        "ex_whac": "Niveau 4 : Les pucks s'allument mais les couleurs tournent toutes les 1.5s ! Restez concentré.", 
        "img_whac": "",
        
        "desc_counter": "Outil d'assistance. Compte simplement combien de fois un joueur appuie sur son puck. (min 0.3s entre les appuis !)", 
        "setup_counter": "1 Puck par joueur. Limite de temps ajustable.", 
        "ex_counter": "Un enfant fait un exercice, court, tape le puck et répète. Qui a le plus de points après 3 min ?", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "Test d'endurance classique. Faire des allers-retours entre le départ et la cible.", 
        "setup_shuttle": "2 Pucks par joueur. Le puck de départ montre une lumière défilante, la cible respire. Départ : Maintenez les pucks jusqu'au signal GO ! Détection de faux départ active.", 
        "ex_shuttle": "Maintenir départ -> \"GO\" -> courir vers la cible & appuyer -> retour au départ & appuyer.", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "Mémorisez la séquence de couleurs ! L'ordinateur la montre, vous la répétez.", 
        "setup_simon": "Jusqu'à 3 groupes en parallèle. Chaque puck a une couleur. Longueur de séquence ajustable.", 
        "ex_simon": "Rouge clignote -> Appuyez Rouge. Tour 2 : Rouge, Bleu clignotent -> Appuyez Rouge, Bleu...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "Mémorisez la séquence ! Courez vers les pucks et appuyez dessus.<br><b>Spécial : Mode Groupe</b><br>Un seul puck d'affichage, tous les groupes résolvent la même séquence.", 
        "setup_simonruns": "Jusqu'à 3 groupes. Chaque puck a une couleur. Longueur de séquence ajustable.", 
        "ex_simonruns": "Rouge clignote -> Courez vers Rouge, appuyez ! Retour à l'affichage...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "Sprints répétés avec des limites de temps décroissantes. Si vous n'arrivez pas à temps, vous êtes éliminé (mordu) !", 
        "setup_zombie": "Définir le temps de départ (ex. 10s) et la réduction par tour (ex. 0.5s).<br><b>Réduction Auto :</b> Le temps baisse après un sprint réussi.<br><b>Mort Subite :</b> Un échec = éliminé.", 
        "ex_zombie": "Maintenir départ -> \"GO\" -> courir vers la cible. Tour suivant : Moins de temps !", 
        "img_zombie": "",
        
        "desc_beep": "Le test d'endurance classique. Courez 20m en rythme avec les signaux. La vitesse augmente chaque minute. Calcule la VO²max.", 
        "setup_beep": "Note : La distance DOIT être d'exactement 20m. Choisir le nombre de joueurs.", 
        "ex_beep": "Signal sonore -> Courir vers la cible et attendre. Trop tôt/tard = carton jaune. 2ème carton = éliminé !", 
        "img_beep": "",
        
        "desc_tabata": "Contrôleur visuel et sonore pour l'entraînement en groupe. Remplace le chrono dans la main du coach.", 
        "setup_tabata": "Placer les pucks aux stations. Définir les temps WORK et REST. Bips 3 secondes avant le changement.", 
        "ex_tabata": "20s Work, 10s Rest. L'anneau vert se vide. À 3s : Bip.. Bip.. Bip. Puis rouge pour 10s de repos.", 
        "img_tabata": "",
        
        "desc_react2p": "Le duel ultime ! Deux joueurs face à face. Touchez votre couleur en premier pour marquer.", 
        "setup_react2p": "Sélectionner le temps et les pucks (min 3). Augmentez la difficulté en ajoutant des couleurs leurres.", 
        "ex_react2p": "P1 cherche Rouge, P2 Bleu. Les pucks s'allument -> touchez le vôtre le plus vite possible !", 
        "img_react2p": "",
        
        "desc_domination": "Jeu d'endurance intense. Deux équipes se battent pour le contrôle du terrain. Capturez et volez les pucks !", 
        "setup_domination": "Dispersez les pucks. Équipe 1 clique 1 FOIS pour capturer. Équipe 2 DOUBLE-CLIQUE pour voler.", 
        "ex_domination": "Équipe 1 court et clique (devient Rouge). Équipe 2 chasse et double-clique (devient Bleu). Qui en a le plus après 2 minutes ?", 
        "img_domination": "",
        
        "desc_target": "Entraîne le gainage et la réaction. Parfait pour les sit-ups ou les planches.", 
        "setup_target": "SIT-UPS : Fixer les pucks au mur. Appuyer à chaque sit-up. Délai de 2-3s pour redescendre.<br>PLANCHES : 3 pucks en demi-cercle. Appuyer d'une main quand allumé.", 
        "ex_target": "Mode Temps (survivre 60s) ou Mode Tours (compléter 30 sit-ups).", 
        "img_target": "",
        
        "desc_ball": "Exercice de dribble moteur. Les pucks servent de stations (ex. en carré).", 
        "setup_ball": "Choisir le nombre de pucks par station. Le joueur dribble vers le puck allumé de sa couleur.", 
        "ex_ball": "4 pucks en carré. Un puck s'allume -> Dribbler vers lui, appuyer, le suivant s'allume.", 
        "img_ball": "",
        
        "desc_batak": "Entraînement de réaction et vision périphérique comme en Formule 1. Un test de stress pour la coordination œil-main.", 
        "setup_batak": "Fixer les pucks écartés sur un mur. Ils s'allument brièvement. Touchez-les avant qu'ils ne s'éteignent !", 
        "ex_batak": "12 pucks sur un mur. 60s, mode \"Moyen\". Les pucks s'allument et disparaissent après 1.2s.", 
        "img_batak": "",
        
        "desc_ttest": "Test standard mondial d'agilité. Sprints et changements de direction sous pression.", 
        "setup_ttest": "SETUP : 4 pucks en forme de T.<br>1/4 anneau : Départ (A)<br>2/4 : Centre (B, à 10m de A)<br>3/4 : Gauche (C, à 5m de B)<br>4/4 : Droite (D, à 10m de C)", 
        "ex_ttest": "Sprint A vers B -> Pas chassés vers C -> Pas chassés vers D -> Pas chassés vers B -> Course arrière vers A.", 
        "img_ttest": "",
        
        "desc_sorting": "Répartissez équitablement un grand groupe de joueurs en équipes de manière ludique.", 
        "setup_sorting": "Choisir le nombre de maisons (groupes), de joueurs, et combien de pucks servent de \"choixpeau\".", 
        "ex_sorting": "20 élèves, 4 maisons. L'algorithme garantit exactement 5 élèves par maison.", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "Tic... Tac... Savez-vous estimer le temps ? Désamorcez la bombe au bon moment !", 
        "setup_bomb": "Choisir le temps (ex. 5s), la difficulté (tolérance) et les tours.", 
        "ex_bomb": "Le puck clignote 5x (=5s). Puis silence. Appuyez exactement après 5s ! Vert = Désamorcé, Rouge = BOUM.", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "Brain jogging ! Entraîne la mémoire de travail spatiale sous charge physique (Dual-Tasking).", 
        "setup_memory": "Dispersez les pucks. Ils affichent des paires de couleurs, puis deviennent neutres. Trouvez les correspondances !<br><b>Mode Recherche :</b> Aucune couleur affichée au départ.", 
        "ex_memory": "Courez vers un puck neutre, appuyez -> Devient Rouge. Retrouvez l'autre puck rouge. Match = Vert !", 
        "img_memory": "",
        
        "desc_redgreen": "Le classique ! Vert = Courir, Rouge = Figer. Atteignez le puck au vert pour marquer. Appuyer au rouge = pénalité.", 
        "setup_redgreen": "Choisir le nombre de groupes. Chaque groupe a son propre rythme.", 
        "ex_redgreen": "Vert -> Courez vite ! Rouge -> Figez immédiatement ! Appuyez uniquement au vert.", 
        "img_redgreen": "",
        
        "desc_pacemaker": "Pacing parfait ! Les pucks agissent comme un \"lièvre\" virtuel indiquant la vitesse de course exacte.", 
        "setup_pacemaker": "Placer les pucks à distance définie (ex. 10m). Ils baissent en luminosité 1s avant que vous deviez y être. N'appuyez pas, concentrez-vous sur la course !", 
        "ex_pacemaker": "Réglé sur 5:00 min/km. Soyez au puck exactement quand la lumière s'éteint !", 
        "img_pacemaker": "",
        
        "desc_hunt": "Chassez votre couleur en cercle ! Cognition et changements de direction rapides.", 
        "setup_hunt": "Min. 3 pucks en cercle. Un puck s'allume à votre couleur -> touchez-le -> un nouveau s'allume instantanément.", 
        "ex_hunt": "Rouge s'allume derrière à gauche -> sprint & appui ! Qui en attrape le plus en 60s ?", 
        "img_hunt": "",
        
        "desc_display": "Mode simple pour contrôler tous les pucks et jouer des effets visuels.", 
        "setup_display": "Les pucks peuvent être contrôlés individuellement ou tous ensemble.", 
        "ex_display": "Accroche-regard. Les enfants adorent les lumières qui clignotent !", 
