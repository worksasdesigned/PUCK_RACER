        "filter_tools": "टूल्स",
        "help_desc": "विवरण", 
        "help_setup": "सेटअप", 
        "help_example": "उदाहरण",
        "g_counter": "सिंपल काउंटर", "g_timer": "सिंपल टाइमर", "g_stopwatch": "स्टॉपवॉच", "g_countdown": "काउंटडाउन",
        "g_shuttle": "शटल रन", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "ज़ॉम्बी एस्केप",
        "g_whac": "व्हैक-ए-मोल", "g_sorting": "सॉर्टिंग हैट", "g_bomb": "बॉम्ब स्क्वाड", "g_redgreen": "रेड लाइट ग्रीन लाइट",
        "g_beep": "Luc Léger (बीप टेस्ट)", "g_react2p": "रिएक्ट 2-प्लेयर", "g_target": "टारगेट टच", "g_ball": "बॉल ड्रिबलिंग",
        "g_ttest": "एजिलिटी T-टेस्ट", "g_hunt": "हंट!", "g_pacemaker": "द पेसमेकर", "g_memory": "मेमोरी स्प्रिंट",
        "g_domination": "डोमिनेशन", "g_batak": "बटाक प्रो", "g_tabata": "तबाता टाइमर", "g_display": "डिस्प्ले मोड", "g_settings": "सेटिंग्स",

        "desc_stopwatch": "एक साधारण स्टॉपवॉच। हर puck अपना खुद का स्टॉपवॉच है। ट्रेनर \"Central Start\" से सभी pucks शुरू कर सकता है। फॉल्स स्टार्ट डिटेक्शन के साथ \"Hold Button + Countdown\" मोड।<br><b>Lap Mode:</b> एक क्लिक से लैप रिकॉर्ड होता है। डबल-क्लिक या 0.5s तक दबाए रखने पर समय रुक जाता है।", 
        "setup_stopwatch": "खिलाड़ियों की संख्या और मोड चुनें।", 
        "ex_stopwatch": "3 खिलाड़ियों के लिए सेट करें, कोई अन्य सेटिंग नहीं। हर puck एक स्टॉपवॉच है। पहला प्रेस = START, दूसरा = STOP।", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "टीचिंग के लिए एक प्रैक्टिकल टूल। हर puck एक छात्र के लिए पर्सनल काउंटडाउन टाइमर का काम करता है।", 
        "setup_timer": "बेस टाइम सेट करें। Pucks जल उठते हैं और सर्कल सैंडग्लास की तरह खाली होता है। जब छात्र का काम हो जाए, तो वह अपना puck दबाता है। आपको तुरंत दिखता है कि किसने पूरा किया।", 
        "ex_timer": "सर्किट ट्रेनिंग, शांत काम या टेस्ट के लिए आदर्श।", 
        "img_timer": "",
        
        "desc_countdown": "एक नंबर से शुरू करें और ज़ीरो तक काउंटडाउन करें। LED रिंग के जरिए विज़ुअलाइज़्ड। गेम से ज़्यादा एक ट्रेनिंग टूल है।", 
        "setup_countdown": "शुरुआती नंबर चुनें (1-100)। विकल्प: पहले विजेता पर रोकें।", 
        "ex_countdown": "30 पर सेट करें। कौन पहले 30 पुश-अप्स कर सकता है (हर बार puck दबाते हुए)?", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "अल्टीमेट रिएक्शन और कॉग्निटिव ड्रिल। Pucks रैंडमली जलते हैं। सही रंगों को खोजें और गलत को इग्नोर करें!", 
        "setup_whac": "अधिकतम 3 ग्रुप्स। गेम कलर्स चुनें और तय करें कि कौन से टारगेट सही हैं। 5 कठिनाई स्तर।", 
        "ex_whac": "लेवल 4: Pucks जलते हैं लेकिन रंग हर 1.5s में बदलते हैं! फोकस रखें।", 
        "img_whac": "",
        
        "desc_counter": "एक ट्रेनिंग सपोर्ट टूल। बस यह गिनता है कि खिलाड़ी कितनी बार puck दबाता है। (इनपुट के बीच न्यूनतम 0.3s!)", 
        "setup_counter": "प्रति खिलाड़ी 1 Puck। एडजस्टेबल समय सीमा।", 
        "ex_counter": "एक बच्चा एक्सरसाइज करता है, दौड़कर puck दबाता है और दोहराता है। 3 मिनट बाद किसके पास सबसे ज़्यादा पॉइंट्स हैं?", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "क्लासिक एंड्योरेंस टेस्ट। स्टार्ट और टारगेट के बीच आगे-पीछे दौड़ें।", 
        "setup_shuttle": "प्रति खिलाड़ी 2 Pucks। स्टार्ट puck रनिंग लाइट दिखाता है, टारगेट सांस लेता है। स्टार्ट: GO सिग्नल तक pucks को दबाए रखें! फॉल्स स्टार्ट डिटेक्शन एक्टिव है।", 
        "ex_shuttle": "स्टार्ट दबाए रखें -> \"GO\" -> टारगेट की ओर दौड़ें और दबाएं -> स्टार्ट पर वापस आएं और दबाएं।", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "कलर पैटर्न याद रखें! कंप्यूटर दिखाता है, आप दोहराते हैं।", 
        "setup_simon": "समानांतर में 3 ग्रुप्स तक। प्रति ग्रुप pucks चुनें। हर puck का एक रंग होता है। एडजस्टेबल सीक्वेंस लेंथ।", 
        "ex_simon": "लाल ब्लिंक -> लाल दबाएं। राउंड 2: लाल, नीला ब्लिंक -> लाल, नीला दबाएं...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "पैटर्न याद रखें! Pucks की ओर दौड़ें और उन्हें दबाएं।<br><b>स्पेशल: ग्रुप मोड</b><br>केवल एक डिस्प्ले puck है, सभी ग्रुप एक ही सीक्वेंस सॉल्व करते हैं।", 
        "setup_simonruns": "अधिकतम 3 ग्रुप्स। हर puck का एक रंग है। एडजस्टेबल सीक्वेंस लेंथ।", 
        "ex_simonruns": "लाल ब्लिंक -> लाल की ओर दौड़ें, उसे दबाएं! डिस्प्ले पर वापस आएं...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "घटते समय के साथ बार-बार स्प्रिंट्स। समय पर नहीं पहुंचे, तो आप बाहर (bitten)! ", 
        "setup_zombie": "स्टार्ट टाइम (जैसे 10s) और प्रति राउंड कमी (जैसे 0.5s) सेट करें。<br><b>ऑटो-रिड्यूस:</b> सफल रन के बाद समय अपने आप कम हो जाता है।<br><b>सडन डेथ:</b> एक फेल = बाहर।", 
        "ex_zombie": "स्टार्ट दबाए रखें -> \"GO\" -> टारगेट की ओर दौड़ें। अगले राउंड में: आपके पास कम समय है!", 
        "img_zombie": "",
        
        "desc_beep": "क्लासिक एंड्योरेंस टेस्ट। सिग्नल के रिदम में 20m दौड़ें। स्पीड हर मिनट बढ़ती है। VO²max कैलकुलेट करता है।", 
        "setup_beep": "नोट: स्टार्ट और टारगेट के बीच की दूरी बिल्कुल 20m होनी चाहिए। खिलाड़ियों की संख्या चुनें।", 
        "ex_beep": "सिग्नल बजता है -> टारगेट की ओर दौड़ें और अगले सिग्नल का इंतज़ार करें। बहुत जल्दी/देर = येलो कार्ड। दूसरा कार्ड = बाहर!", 
        "img_beep": "",
        
        "desc_tabata": "ग्रुप ट्रेनिंग के लिए विज़ुअल और अकॉस्टिक कंट्रोलर। ट्रेनर के हाथ से स्टॉपवॉच हटा देता है।", 
        "setup_tabata": "Pucks को स्टेशन्स पर रखें। WORK और REST का समय सेट करें। स्विच होने से 3 सेकंड पहले बीप करता है।", 
        "ex_tabata": "20s Work, 10s Rest। हरी रिंग खाली होती दिखती है। 3s पर: बीप.. बीप.. बीप। फिर 10s के आराम के लिए लाल रंग।", 
        "img_tabata": "",
        
        "desc_react2p": "अल्टीमेट ड्यूल! दो खिलाड़ी आमने-सामने। स्कोर करने के लिए अपना रंग पहले हिट करें।", 
        "setup_react2p": "समय और pucks (न्यूनतम 3) चुनें। फेक कलर्स जोड़कर कठिनाई बढ़ाएं।", 
        "ex_react2p": "P1 लाल ढूंढता है, P2 नीला। Pucks जलते हैं -> अपना रंग जितनी जल्दी हो सके हिट करें!", 
        "img_react2p": "",
        
        "desc_domination": "इंटेंस एंड्योरेंस गेम। दो टीमें फील्ड कंट्रोल के लिए लड़ती हैं। Pucks कैप्चर करें और उन्हें चुराएं!", 
        "setup_domination": "फील्ड में pucks फैलाएं। टीम 1 कैप्चर करने के लिए 1 बार क्लिक करती है। टीम 2 चुराने के लिए डबल-क्लिक करती है।", 
        "ex_domination": "टीम 1 दौड़कर क्लिक करती है (लाल हो जाता है)। टीम 2 पीछा करती है और डबल-क्लिक करती है (नीला हो जाता है)। 2 मिनट बाद किसके पास ज़्यादा हैं?", 
        "img_domination": "",
        
        "desc_target": "कोर स्टेबिलिटी और रिएक्शन टाइम को ट्रेन करता है। सिट-अप्स या प्लैंक्स के लिए परफेक्ट असिस्टेंट।", 
        "setup_target": "सिट-अप्स: Pucks को दीवार पर लगाएं। हर सिट-अप पर जलते हुए puck को दबाएं। नीचे जाने के लिए 2-3s का पॉज़ रखें।<br>प्लैंक्स: 3 pucks सेमी-सर्कल में रखें। जलने पर एक हाथ उठाकर दबाएं।", 
        "ex_target": "टाइम मोड (जैसे 60s तक बचें) या राउंड्स मोड (जैसे 30 सिट-अप्स पूरे करें) चुनें।", 
        "img_target": "",
        
        "desc_ball": "मोटर ड्रिबलिंग ड्रिल। Pucks को स्टेशन्स के रूप में रखें (जैसे एक वर्ग में)।", 
        "setup_ball": "प्रति स्टेशन pucks चुनें। खिलाड़ी अपने रंग के जलते हुए puck की ओर ड्रिबल करता है।", 
        "ex_ball": "एक वर्ग में 4 pucks रखें। एक puck जलता है -> उसकी ओर ड्रिबल करें, दबाएं, फिर अगला जलता है।", 
        "img_ball": "",
        
        "desc_batak": "फॉर्मूला 1 जैसी रिएक्शन और पेरिफेरल विज़न ट्रेनिंग। हैंड-आई कोऑर्डिनेशन के लिए स्ट्रेस टेस्ट।", 
        "setup_batak": "Pucks को दीवार पर दूर-दूर लगाएं। वे रैंडमली थोड़ी देर के लिए जलते हैं। उनके गायब होने से पहले उन्हें हिट करें!", 
        "ex_batak": "दीवार पर 12 pucks लगाएं। 60s और \"मीडियम\" सेट करें। Pucks जलते हैं और 1.2s बाद गायब हो जाते हैं।", 
        "img_batak": "",
        
        "desc_ttest": "एजिलिटी के लिए ग्लोबल स्टैंडर्ड टेस्ट। टाइम प्रेशर में स्प्रिंट्स और डायरेक्शन चेंज।", 
        "setup_ttest": "SETUP: 4 pucks को T-शेप में रखें।<br>1/4 रिंग: स्टार्ट (A)<br>2/4 रिंग: सेंटर (B, A से 10m आगे)<br>3/4 रिंग: लेफ्ट (C, B से 5m दूर)<br>4/4 रिंग: राइट (D, C से 10m दूर)", 
        "ex_ttest": "A से B स्प्रिंट -> साइड-स्टेप C की ओर -> साइड-स्टेप D की ओर -> वापस B की ओर -> बैकपैडल करते हुए A पर।", 
        "img_ttest": "",
        
        "desc_sorting": "एक बड़े ग्रुप को समान टीमों में निष्पक्ष रूप से बांटता है।", 
        "setup_sorting": "हाउसेस (ग्रुप्स) की संख्या, कुल खिलाड़ी और कितने pucks \"सॉर्टिंग हैट\" के रूप में काम करेंगे, यह चुनें।", 
        "ex_sorting": "20 छात्र, 4 हाउसेस। अल्गोरिथम हर हाउस में बिल्कुल 5 छात्रों की गारंटी देता है।", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "टिक... टॉक... क्या आप समय का अंदाज़ा लगा सकते हैं? सही समय पर बम को डिफ़्यूज़ करें!", 
        "setup_bomb": "समय (जैसे 5s), कठिनाई (टॉलरेंस) और राउंड्स चुनें।", 
        "ex_bomb": "Puck 5 बार ब्लिंक करता है (=5s)। फिर काउंटडाउन। फिर सन्नाटा। ठीक 5 सेकंड बाद दबाएं! हरा = डिफ़्यूज़, लाल = BOOM।", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "ब्रेन जॉगिंग! फिजिकल लोड (डुअल-टास्किंग) के तहत स्पेटियल वर्किंग मेमोरी को ट्रेन करता है।", 
        "setup_memory": "Pucks को बड़े एरिया में फैलाएं। Pucks कलर पेयर्स दिखाते हैं, फिर न्यूट्रल हो जाते हैं। पेयर्स ढूंढकर दबाएं!<br><b>सर्च मोड:</b> शुरू में कोई रंग नहीं दिखता।", 
        "ex_memory": "एक न्यूट्रल puck की ओर दौड़ें, दबाएं -> लाल हो जाता है। याद करें दूसरा लाल puck कहां था। मैच = हरा!", 
        "img_memory": "",
        
        "desc_redgreen": "क्लासिक! हरा = दौड़ें, लाल = रुकें। स्कोर करने के लिए हरे रंग पर पहुंचें। लाल पर दबाने से पेनल्टी मिलती है।", 
        "setup_redgreen": "ग्रुप्स की संख्या चुनें। हर ग्रुप की अपनी रिदम होती है।", 
        "ex_redgreen": "हरा -> तेज़ दौड़ें! लाल -> तुरंत रुकें! केवल हरा होने पर ही दबाएं।", 
        "img_redgreen": "",
        
        "desc_pacemaker": "परफेक्ट पेसिंग! Pucks एक वर्चुअल \"रैबिट\" के रूप में दौड़ने की सटीक स्पीड दिखाते हैं।", 
        "setup_pacemaker": "Pucks को निश्चित दूरी (जैसे 10m) पर रखें। वहां पहुंचने से 1s पहले उनकी रोशनी कम हो जाती है। उन्हें दबाएं नहीं, बस दौड़ने पर फोकस करें!", 
        "ex_pacemaker": "5:00 min/km सेट करें। लाइट बंद होते ही ठीक उसी समय puck पर मौजूद रहें!", 
        "img_pacemaker": "",
        
        "desc_hunt": "सर्कल में अपने रंग का शिकार करें! कॉग्निशन और तेज़ डायरेक्शन चेंज।", 
        "setup_hunt": "न्यूनतम 3 pucks सर्कल में रखें। आपका रंग जलता है -> उसे हिट करें -> तुरंत एक नया जलता है।", 
        "ex_hunt": "पीछे बाईं ओर लाल जलता है -> स्प्रिंट और प्रेस! 60s में सबसे ज़्यादा कौन पकड़ता है?", 
        "img_hunt": "",
        
        "desc_display": "सभी pucks को कंट्रोल करने और विज़ुअल इफेक्ट्स चलाने के लिए सिंपल डिस्प्ले मोड।", 
        "setup_display": "Pucks को अलग-अलग या एक साथ कंट्रोल किया जा सकता है।", 
        "ex_display": "आकर्षक। बच्चों को ब्लिंकिंग लाइट्स बहुत पसंद आती हैं!", 
        "img_display": "game_display.jpg",

