		"filter_fav": "⭐ Favoritos",
        
        "filter_all": "Todos os Jogos", 
        "filter_reaction": "Reação", 
        "filter_brain": "Memória e Lógica", 
        "filter_sport": "Treino", 
        "filter_tools": "Ferramentas",
        "help_desc": "Descrição", 
        "help_setup": "Configuração", 
        "help_example": "Exemplo",
        "g_counter": "Contador Simples", "g_timer": "Temporizador", "g_stopwatch": "Cronômetro", "g_countdown": "Contagem Regressiva",
        "g_shuttle": "Shuttle Run", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "Zombie Escape",
        "g_whac": "Whac-A-Mole", "g_sorting": "Chapéu Seletor", "g_bomb": "Esquadrão Antibomba", "g_redgreen": "Luz Vermelha, Luz Verde",
        "g_beep": "Luc Léger (Teste Beep)", "g_react2p": "Reação 2 Jogadores", "g_target": "Target Touch", "g_ball": "Drible de Bola",
        "g_ttest": "Agility T-Test", "g_hunt": "Hunt!", "g_pacemaker": "O Pacemaker", "g_memory": "Memory Sprint",
        "g_domination": "Dominação", "g_batak": "Batak Pro", "g_tabata": "Tabata Timer", "g_display": "Modo Tela", "g_settings": "Configurações",

        "desc_stopwatch": "Um cronômetro simples. Cada puck atua como um cronômetro independente. O treinador pode iniciar todos via \"START Central\". Inclui modo \"Segurar + Contagem\" com detecção de falsa partida.<br><b>Modo Volta:</b> Um clique registra uma volta. Duplo clique ou segurar (0.5s) para o tempo.", 
        "setup_stopwatch": "Selecione a contagem de jogadores e o modo.", 
        "ex_stopwatch": "Ex: 3 jogadores, sem mais configurações. Cada puck é um cronômetro. 1º toque = START, 2º = STOP.", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "Ferramenta prática para ensino. Cada puck serve como contagem regressiva pessoal para um aluno.", 
        "setup_timer": "Defina o tempo base. Os pucks acendem e o círculo esvazia como uma ampulheta. Quando um aluno termina, ele pressiona seu puck. Você vê imediatamente quem terminou.", 
        "ex_timer": "Ideal para treino em circuito, trabalho silencioso ou testes.", 
        "img_timer": "",
        
        "desc_countdown": "Começa com um número e conta regressivamente até zero. Visualizado pelo anel de LED. Mais uma ferramenta de treino do que um jogo.", 
        "setup_countdown": "Escolha o número inicial (1-100). Opção: Parar no primeiro vencedor.", 
        "ex_countdown": "Definido para 30. Quem consegue fazer 30 flexões primeiro (pressionando o puck a cada vez)?", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "O exercício definitivo de reação e cognição. Os pucks acendem aleatoriamente. Encontre as cores válidas e ignore as erradas!", 
        "setup_whac": "Até 3 grupos. Defina as cores do jogo e selecione os alvos válidos. 5 níveis de dificuldade.", 
        "ex_whac": "Nível 4: Pucks acendem, mas as cores giram a cada 1.5s! Mantenha o foco.", 
        "img_whac": "",
        
        "desc_counter": "Ferramenta de apoio. Conta simplesmente quantas vezes um jogador pressiona seu puck. (mín. 0.3s entre toques!)", 
        "setup_counter": "1 Puck por jogador. Limite de tempo ajustável.", 
        "ex_counter": "Uma criança faz um exercício, corre, toca no puck e repete. Quem tem mais pontos após 3 min?", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "Teste clássico de resistência. Corra de um lado para o outro entre o início e o alvo.", 
        "setup_shuttle": "2 Pucks por jogador. O puck inicial mostra uma luz móvel, o alvo respira. Início: Segure os pucks até o sinal GO! Detecção de falsa partida ativa.", 
        "ex_shuttle": "Segurar início -> \"GO\" -> correr para o alvo e pressionar -> voltar ao início e pressionar.", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "Memorize o padrão de cores! O sistema mostra, você repete.", 
        "setup_simon": "Até 3 grupos paralelos. Cada puck tem uma cor. Comprimento de sequência ajustável.", 
        "ex_simon": "Vermelho pisca -> Pressione Vermelho. Rodada 2: Vermelho, Azul piscam -> Pressione Vermelho, Azul...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "Memorize o padrão! Corra até os pucks e pressione-os.<br><b>Especial: Modo Grupo</b><br>Apenas um puck de exibição, todos os grupos resolvem a mesma sequência.", 
        "setup_simonruns": "Até 3 grupos. Cada puck tem uma cor. Comprimento de sequência ajustável.", 
        "ex_simonruns": "Vermelho pisca -> Corra para o Vermelho, pressione! Volte para a exibição...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "Sprints repetidos com tempo limite decrescente. Falhe em chegar a tempo e você está fora (mordido)!", 
        "setup_zombie": "Defina o tempo inicial (ex. 10s) e a redução por rodada (ex. 0.5s).<br><b>Redução Auto:</b> O tempo cai após um sprint de sucesso.<br><b>Morte Súbita:</b> Uma falha = fora.", 
        "ex_zombie": "Segurar início -> \"GO\" -> correr para o alvo. Próxima rodada: Você tem menos tempo!", 
        "img_zombie": "",
        
        "desc_beep": "O clássico teste de resistência. Corra 20m no ritmo dos sinais. A velocidade aumenta a cada minuto. Calcula o VO²max.", 
        "setup_beep": "Nota: A distância DEVE ser de exatos 20m. Escolha o número de jogadores.", 
        "ex_beep": "Sinal soa -> Corra para o alvo e espere. Muito cedo/tarde = cartão amarelo. 2º cartão = eliminado!", 
        "img_beep": "",
        
        "desc_tabata": "Controlador visual e sonoro para treino em grupo. Tira o cronômetro da mão do treinador.", 
        "setup_tabata": "Coloque os pucks nas estações. Defina tempos WORK e REST. Apita 3 segundos antes de trocar.", 
        "ex_tabata": "20s Work, 10s Rest. O anel verde esvazia. Aos 3s: Bip.. Bip.. Bip. Depois vermelho respirando por 10s de descanso.", 
        "img_tabata": "",
        
        "desc_react2p": "O duelo definitivo! Dois jogadores frente a frente. Toque na sua cor primeiro para pontuar.", 
        "setup_react2p": "Selecione tempo e pucks (mín. 3). Aumente a dificuldade adicionando cores falsas.", 
        "ex_react2p": "J1 procura Vermelho, J2 Azul. Os pucks acendem -> toque no seu o mais rápido possível!", 
        "img_react2p": "",
        
        "desc_domination": "Jogo intenso de resistência. Duas equipes lutam pelo controle do campo. Capture e roube os pucks!", 
        "setup_domination": "Espalhe os pucks. Equipe 1 dá 1 CLIQUE para capturar. Equipe 2 DUPLO CLIQUE para roubar.", 
        "ex_domination": "Equipe 1 corre e clica (fica Vermelho). Equipe 2 persegue e clica duas vezes (fica Azul). Quem tem mais após 2 min?", 
        "img_domination": "",
        
        "desc_target": "Treina estabilidade do core e reação. Assistente perfeito para abdominais ou pranchas.", 
        "setup_target": "ABDOMINAIS: Fixe os pucks na parede. Pressione a cada abdominal. Atraso de 2-3s para descer.<br>PRANCHAS: 3 pucks em semicírculo. Levante uma mão e pressione quando acender.", 
        "ex_target": "Modo Tempo (sobreviva 60s) ou Modo Rodadas (complete 30 abdominais).", 
        "img_target": "",
        
        "desc_ball": "Exercício motor de drible. Os pucks servem de estações (ex. num quadrado).", 
        "setup_ball": "Escolha os pucks por estação. O jogador dribla até o puck aceso da sua cor.", 
        "ex_ball": "4 pucks em quadrado. Um puck acende -> Drible até ele, pressione, o próximo acende.", 
        "img_ball": "",
        
        "desc_batak": "Treino de reação e visão periférica como na Fórmula 1. Um teste de estresse para coordenação olho-mão.", 
        "setup_batak": "Fixe os pucks afastados numa parede. Eles acendem brevemente. Toque neles antes que apaguem!", 
        "ex_batak": "12 pucks na parede. 60s, modo \"Médio\". Pucks acendem e somem após 1.2s.", 
        "img_batak": "",
        
        "desc_ttest": "Teste padrão global de agilidade. Sprints e mudanças de direção sob pressão.", 
        "setup_ttest": "SETUP: 4 pucks em forma de T.<br>1/4 anel: Início (A)<br>2/4: Centro (B, a 10m de A)<br>3/4: Esquerda (C, a 5m de B)<br>4/4: Direita (D, a 10m de C)", 
        "ex_ttest": "Sprint A para B -> Passo lateral para C -> Passo lateral para D -> Passo lateral para B -> Corrida de costas para A.", 
        "img_ttest": "",
        
        "desc_sorting": "Divida de forma justa um grupo grande de jogadores em equipes.", 
        "setup_sorting": "Escolha o número de casas (grupos), total de jogadores e quantos pucks atuam como \"chapéu seletor\".", 
        "ex_sorting": "20 alunos, 4 casas. O algoritmo garante exatos 5 alunos por casa.", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "Tic... Tac... Sabe calcular o tempo? Desarme a bomba no momento exato!", 
        "setup_bomb": "Escolha o tempo (ex. 5s), dificuldade (tolerância) e rodadas.", 
        "ex_bomb": "O puck pisca 5x (=5s). Depois silêncio. Pressione exatamente após 5s! Verde = Desarmado, Vermelho = BOOM.", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "Ginástica cerebral! Treina a memória de trabalho espacial sob carga física (Dual-Tasking).", 
        "setup_memory": "Espalhe os pucks. Mostram pares de cores, depois ficam neutros. Encontre os pares!<br><b>Modo Busca:</b> Sem cores iniciais.", 
        "ex_memory": "Corra até um puck neutro, pressione -> Fica Vermelho. Lembre onde estava o outro. Par = Verde!", 
        "img_memory": "",
        
        "desc_redgreen": "O clássico! Verde = Correr, Vermelho = Congelar. Alcance o puck no verde para pontuar. Tocar no vermelho penaliza.", 
        "setup_redgreen": "Escolha o número de grupos. Cada grupo tem seu próprio ritmo.", 
        "ex_redgreen": "Verde -> Corra rápido! Vermelho -> Congele imediatamente! Só pressione no verde.", 
        "img_redgreen": "",
        
        "desc_pacemaker": "Pacing perfeito! Os pucks agem como uma \"lebre\" virtual indicando a velocidade exata.", 
        "setup_pacemaker": "Coloque os pucks a distâncias definidas (ex. 10m). O brilho diminui 1s antes de você chegar lá. Não pressione, apenas corra!", 
        "ex_pacemaker": "Definido para 5:00 min/km. Chegue ao puck exatamente quando a luz apagar!", 
        "img_pacemaker": "",
        
        "desc_hunt": "Cace sua cor em círculo! Cognição e mudanças rápidas de direção.", 
        "setup_hunt": "Mín. 3 pucks em círculo. Um puck da sua cor acende -> toque nele -> um novo acende instantaneamente.", 
        "ex_hunt": "Vermelho acende atrás esq. -> sprint e toque! Quem pega mais em 60s?", 
        "img_hunt": "",
        
        "desc_display": "Modo simples para controlar todos os pucks e exibir efeitos visuais.", 
        "setup_display": "Os pucks podem ser controlados individualmente ou todos juntos.", 
        "ex_display": "Chamativo. Crianças adoram luzes piscando!", 
        "img_display": "game_display.jpg",

