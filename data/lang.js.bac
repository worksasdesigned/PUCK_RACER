        "g_counter": "Contatore Semplice", "g_timer": "Timer Semplice", "g_stopwatch": "Cronometro", "g_countdown": "Conto alla rovescia",
        "g_shuttle": "Shuttle Run", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "Zombie Escape",
        "g_whac": "Whac-A-Mole", "g_sorting": "Cappello Parlante", "g_bomb": "Artificiere", "g_redgreen": "1, 2, 3, Stella!",
        "g_beep": "Luc Léger (Test Navetta)", "g_react2p": "Reazione 2 Gioc.", "g_target": "Target Touch", "g_ball": "Dribbling Palla",
        "g_ttest": "Agility T-Test", "g_hunt": "Hunt!", "g_pacemaker": "Il Pacemaker", "g_memory": "Memory Sprint",
        "g_domination": "Dominazione", "g_batak": "Batak Pro", "g_tabata": "Tabata Timer", "g_display": "Modo Display", "g_settings": "Impostazioni",

        "desc_stopwatch": "Un semplice cronometro. Ogni puck funge da cronometro indipendente. L'allenatore può avviare tutti tramite \"START Centrale\". Include modalità \"Tieni premuto + Conto alla rovescia\" con rilevamento false partenze.<br><b>Modo Giro:</b> Un clic registra un giro. Doppio clic o pressione (0.5s) ferma il tempo.", 
        "setup_stopwatch": "Seleziona numero giocatori e modalità.", 
        "ex_stopwatch": "Es. 3 giocatori, nessun'altra impostazione. Ogni puck è un cronometro. 1° tocco = START, 2° = STOP.", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "Strumento pratico per l'insegnamento. Ogni puck funge da conto alla rovescia personale per uno studente.", 
        "setup_timer": "Imposta il tempo base. I puck si accendono e il cerchio si svuota come una clessidra. Quando uno studente finisce, preme il suo puck. Vedi subito chi ha finito.", 
        "ex_timer": "Ideale per circuit training, lavoro silenzioso o test.", 
        "img_timer": "",
        
        "desc_countdown": "Inizia con un numero e fa il conto alla rovescia fino a zero. Visualizzato tramite l'anello LED. Più uno strumento di allenamento che un gioco.", 
        "setup_countdown": "Scegli il numero di partenza (1-100). Opzione: Stop al primo vincitore.", 
        "ex_countdown": "Impostato a 30. Chi riesce a fare 30 flessioni per primo (premendo il puck ogni volta)?", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "L'esercizio definitivo di reazione e cognizione. I puck si accendono casualmente. Trova i colori validi e ignora quelli sbagliati!", 
        "setup_whac": "Fino a 3 gruppi. Definisci i colori del gioco e seleziona i bersagli validi. 5 livelli di difficoltà.", 
        "ex_whac": "Livello 4: I puck si accendono ma i colori cambiano ogni 1.5s! Mantieni la concentrazione.", 
        "img_whac": "",
        
        "desc_counter": "Strumento di supporto. Conta semplicemente quante volte un giocatore preme il suo puck. (min 0.3s tra i tocchi!)", 
        "setup_counter": "1 Puck per giocatore. Limite di tempo regolabile.", 
        "ex_counter": "Un bambino fa un esercizio, corre, tocca il puck e ripete. Chi ha più punti dopo 3 min?", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "Classico test di resistenza. Corri avanti e indietro tra la partenza e il bersaglio.", 
        "setup_shuttle": "2 Puck per giocatore. Il puck di partenza mostra una luce in movimento, il bersaglio respira. Partenza: Tieni premuti i puck fino al segnale GO! Rilevamento falsa partenza attivo.", 
        "ex_shuttle": "Tieni premuto partenza -> \"GO\" -> corri al bersaglio e premi -> torna alla partenza e premi.", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "Memorizza la sequenza di colori! Il sistema la mostra, tu la ripeti.", 
        "setup_simon": "Fino a 3 gruppi in parallelo. Ogni puck ha un colore. Lunghezza sequenza regolabile.", 
        "ex_simon": "Rosso lampeggia -> Premi Rosso. Round 2: Rosso, Blu lampeggiano -> Premi Rosso, Blu...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "Memorizza la sequenza! Corri verso i puck e premili.<br><b>Speciale: Modo Gruppo</b><br>Un solo puck display, tutti i gruppi risolvono la stessa sequenza.", 
        "setup_simonruns": "Fino a 3 gruppi. Ogni puck ha un colore. Lunghezza sequenza regolabile.", 
        "ex_simonruns": "Rosso lampeggia -> Corri al Rosso, premilo! Torna al display...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "Sprint ripetuti con limiti di tempo decrescenti. Se non arrivi in tempo, sei fuori (morso)!", 
        "setup_zombie": "Imposta tempo di partenza (es. 10s) e riduzione per round (es. 0.5s).<br><b>Riduzione Auto:</b> Il tempo scende dopo uno sprint riuscito.<br><b>Morte Improvvisa:</b> Un errore = eliminato.", 
        "ex_zombie": "Tieni premuto partenza -> \"GO\" -> corri al bersaglio. Prossimo round: Hai meno tempo!", 
        "img_zombie": "",
        
        "desc_beep": "Il classico test di resistenza. Corri 20m a ritmo con i segnali. La velocità aumenta ogni minuto. Calcola il VO²max.", 
        "setup_beep": "Nota: La distanza DEVE essere esattamente di 20m. Scegli il numero di giocatori.", 
        "ex_beep": "Suona il segnale -> Corri al bersaglio e aspetta. Troppo presto/tardi = cartellino giallo. 2° cartellino = eliminato!", 
        "img_beep": "",
        
        "desc_tabata": "Controller visivo e acustico per allenamento di gruppo. Toglie il cronometro dalla mano dell'allenatore.", 
        "setup_tabata": "Posiziona i puck nelle stazioni. Imposta tempi WORK e REST. Suona 3 secondi prima del cambio.", 
        "ex_tabata": "20s Work, 10s Rest. L'anello verde si svuota. A 3s: Bip.. Bip.. Bip. Poi rosso che respira per 10s di riposo.", 
        "img_tabata": "",
        
        "desc_react2p": "Il duello finale! Due giocatori faccia a faccia. Tocca il tuo colore per primo per fare punto.", 
        "setup_react2p": "Seleziona tempo e puck (min 3). Aumenta la difficoltà aggiungendo colori falsi.", 
        "ex_react2p": "G1 cerca Rosso, G2 Blu. I puck si accendono -> tocca il tuo il più velocemente possibile!", 
        "img_react2p": "",
        
        "desc_domination": "Intenso gioco di resistenza. Due squadre lottano per il controllo del campo. Cattura e ruba i puck!", 
        "setup_domination": "Spargi i puck. Squadra 1 fa 1 CLIC per catturare. Squadra 2 fa DOPPIO CLIC per rubare.", 
        "ex_domination": "Squadra 1 corre e clicca (diventa Rosso). Squadra 2 insegue e fa doppio clic (diventa Blu). Chi ne ha di più dopo 2 min?", 
        "img_domination": "",
        
        "desc_target": "Allena la stabilità del core e la reazione. Assistente perfetto per addominali o plank.", 
        "setup_target": "ADDOMINALI: Fissa i puck al muro. Premi ad ogni addominale. Ritardo 2-3s per scendere.<br>PLANK: 3 puck a semicerchio. Alza una mano e premi quando si accende.", 
        "ex_target": "Modo Tempo (sopravvivi 60s) o Modo Round (completa 30 addominali).", 
        "img_target": "",
        
        "desc_ball": "Esercizio motorio di palleggio. I puck servono da stazioni (es. in un quadrato).", 
        "setup_ball": "Scegli i puck per stazione. Il giocatore palleggia verso il puck acceso del suo colore.", 
        "ex_ball": "4 puck a quadrato. Un puck si accende -> Palleggia verso di esso, premi, si accende il successivo.", 
        "img_ball": "",
        
        "desc_batak": "Allenamento di reazione e visione periferica come in Formula 1. Un test di stress per la coordinazione occhio-mano.", 
        "setup_batak": "Fissa i puck distanziati su un muro. Si accendono brevemente. Toccali prima che si spengano!", 
        "ex_batak": "12 puck a muro. 60s, modo \"Medio\". I puck si accendono e scompaiono dopo 1.2s.", 
        "img_batak": "",
        
        "desc_ttest": "Test standard globale di agilità. Sprint e cambi di direzione sotto pressione.", 
        "setup_ttest": "SETUP: 4 puck a forma di T.<br>1/4 anello: Partenza (A)<br>2/4: Centro (B, a 10m da A)<br>3/4: Sinistra (C, a 5m da B)<br>4/4: Destra (D, a 10m da C)", 
        "ex_ttest": "Sprint A verso B -> Passo laterale a C -> Passo laterale a D -> Passo laterale a B -> Corsa all'indietro ad A.", 
        "img_ttest": "",
        
        "desc_sorting": "Dividi in modo equo un grande gruppo di giocatori in squadre.", 
        "setup_sorting": "Scegli il numero di case (gruppi), giocatori totali e quanti puck fungono da \"cappello parlante\".", 
        "ex_sorting": "20 studenti, 4 case. L'algoritmo garantisce esattamente 5 studenti per casa.", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "Tic... Tac... Sai calcolare il tempo? Disinnesca la bomba al momento esatto!", 
        "setup_bomb": "Scegli tempo (es. 5s), difficoltà (tolleranza) e round.", 
        "ex_bomb": "Il puck lampeggia 5x (=5s). Poi silenzio. Premi esattamente dopo 5s! Verde = Disinnescata, Rosso = BOOM.", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "Ginnastica mentale! Allena la memoria di lavoro spaziale sotto sforzo fisico (Dual-Tasking).", 
        "setup_memory": "Spargi i puck. Mostrano coppie di colori, poi diventano neutri. Trova le coppie!<br><b>Modo Ricerca:</b> Nessun colore iniziale.", 
        "ex_memory": "Corri verso un puck neutro, premi -> Diventa Rosso. Ricorda dove era l'altro. Coppia = Verde!", 
        "img_memory": "",
        
        "desc_redgreen": "Il classico! Verde = Corri, Rosso = Fermati. Raggiungi il puck sul verde per fare punto. Toccare sul rosso penalizza.", 
        "setup_redgreen": "Scegli il numero di gruppi. Ogni gruppo ha il suo ritmo.", 
        "ex_redgreen": "Verde -> Corri veloce! Rosso -> Fermati subito! Premi solo sul verde.", 
        "img_redgreen": "",
        
        "desc_pacemaker": "Pacing perfetto! I puck agiscono come una \"lepre\" virtuale indicando la velocità esatta.", 
        "setup_pacemaker": "Posiziona i puck a distanza fissa (es. 10m). La luce si abbassa 1s prima che tu debba essere lì. Non premere, corri e basta!", 
        "ex_pacemaker": "Impostato a 5:00 min/km. Arriva al puck esattamente quando la luce si spegne!", 
        "img_pacemaker": "",
        
        "desc_hunt": "Caccia il tuo colore in cerchio! Cognizione e rapidi cambi di direzione.", 
        "setup_hunt": "Min. 3 puck in cerchio. Un puck del tuo colore si accende -> toccalo -> se ne accende subito uno nuovo.", 
        "ex_hunt": "Rosso si accende dietro a sx -> sprint e tocco! Chi ne prende di più in 60s?", 
        "img_hunt": "",
        
        "desc_display": "Modo semplice per controllare tutti i puck e mostrare effetti visivi.", 
        "setup_display": "I puck possono essere controllati singolarmente o tutti insieme.", 
        "ex_display": "Attira-sguardi. I bambini adorano le luci lampeggianti!", 
        "img_display": "game_display.jpg",

