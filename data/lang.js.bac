        "g_counter": "Contador simple", "g_timer": "Temporizador", "g_stopwatch": "Cronómetro", "g_countdown": "Cuenta atrás",
        "g_shuttle": "Shuttle Run", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "Zombie Escape",
        "g_whac": "Whac-A-Mole", "g_sorting": "Sombrero Seleccionador", "g_bomb": "Artificiero", "g_redgreen": "Luz Roja, Luz Verde",
        "g_beep": "Luc Léger (Test Navette)", "g_react2p": "Reacción 2 Jug.", "g_target": "Target Touch", "g_ball": "Dribbling Balón",
        "g_ttest": "Agility T-Test", "g_hunt": "Hunt!", "g_pacemaker": "El Pacemaker", "g_memory": "Memory Sprint",
        "g_domination": "Dominación", "g_batak": "Batak Pro", "g_tabata": "Tabata Timer", "g_display": "Modo Pantalla", "g_settings": "Ajustes",

        "desc_stopwatch": "Un cronómetro simple. Cada puck actúa como un cronómetro independiente. El entrenador puede iniciar todos vía \"START Central\". Incluye modo \"Mantener + Cuenta atrás\" con detección de salida en falso.<br><b>Modo Vuelta:</b> Un clic registra una vuelta. Doble clic o mantener (0.5s) detiene el tiempo.", 
        "setup_stopwatch": "Selecciona número de jugadores y modo.", 
        "ex_stopwatch": "Ej. 3 jugadores, sin más ajustes. Cada puck es un cronómetro. 1er toque = START, 2º = STOP.", 
        "img_stopwatch": "game_stopwatch.jpg",
        
        "desc_timer": "Herramienta práctica para la enseñanza. Cada puck sirve como una cuenta atrás personal para un alumno.", 
        "setup_timer": "Ajusta el tiempo base. Los pucks se encienden y el círculo se vacía como un reloj de arena. Cuando un alumno termina, presiona su puck. Ves inmediatamente quién terminó.", 
        "ex_timer": "Ideal para entrenamiento en circuito, trabajo en silencio o tests.", 
        "img_timer": "",
        
        "desc_countdown": "Comienza con un número y cuenta hacia atrás hasta cero. Visualizado a través del anillo LED. Más una herramienta de entrenamiento que un juego.", 
        "setup_countdown": "Elige el número inicial (1-100). Opción: Parar con el primer ganador.", 
        "ex_countdown": "Ajustado a 30. ¿Quién puede hacer 30 flexiones primero (presionando el puck cada vez)?", 
        "img_countdown": "game_countdown.jpg",
        
        "desc_whac": "El ejercicio definitivo de reacción y cognición. Los pucks se encienden al azar. ¡Encuentra los colores válidos e ignora los incorrectos!", 
        "setup_whac": "Hasta 3 grupos. Define los colores del juego y selecciona los objetivos válidos. 5 niveles de dificultad.", 
        "ex_whac": "Nivel 4: ¡Los pucks se encienden pero los colores rotan cada 1.5s! Mantén la concentración.", 
        "img_whac": "",
        
        "desc_counter": "Herramienta de apoyo. Cuenta simplemente cuántas veces presiona un jugador su puck. (¡Mín. 0.3s entre toques!)", 
        "setup_counter": "1 Puck por jugador. Límite de tiempo ajustable.", 
        "ex_counter": "Un niño hace un ejercicio, corre, toca el puck y repite. ¿Quién tiene más puntos tras 3 min?", 
        "img_counter": "game_simple_counter.jpg",
        
        "desc_shuttle": "Test de resistencia clásico. Corre de ida y vuelta entre el inicio y el objetivo.", 
        "setup_shuttle": "2 Pucks por jugador. El puck inicial muestra una luz en movimiento, el objetivo respira. Inicio: ¡Mantén los pucks hasta el GO! Detección de salida en falso activa.", 
        "ex_shuttle": "Mantener inicio -> \"GO\" -> correr al objetivo y presionar -> volver al inicio y presionar.", 
        "img_shuttle": "game_shuttle_run.jpg",
        
        "desc_simon": "¡Memoriza el patrón de colores! El sistema lo muestra, tú lo repites.", 
        "setup_simon": "Hasta 3 grupos en paralelo. Cada puck tiene un color. Longitud de secuencia ajustable.", 
        "ex_simon": "Rojo parpadea -> Presiona Rojo. Ronda 2: Rojo, Azul parpadean -> Presiona Rojo, Azul...", 
        "img_simon": "game_simon.jpg",
        
        "desc_simonruns": "¡Memoriza el patrón! Corre hacia los pucks y presiónalos.<br><b>Especial: Modo Grupo</b><br>Solo un puck de pantalla, todos los grupos resuelven la misma secuencia.", 
        "setup_simonruns": "Hasta 3 grupos. Cada puck tiene un color. Longitud de secuencia ajustable.", 
        "ex_simonruns": "Rojo parpadea -> ¡Corre hacia el Rojo, presiónalo! Vuelve a la pantalla...", 
        "img_simonruns": "game_simonruns.jpg",
        
        "desc_zombie": "Sprints repetidos con límites de tiempo decrecientes. Si no llegas a tiempo, ¡estás eliminado (mordido)!", 
        "setup_zombie": "Configura tiempo de inicio (ej. 10s) y reducción por ronda (ej. 0.5s).<br><b>Reducción Auto:</b> El tiempo baja tras un sprint exitoso.<br><b>Muerte Súbita:</b> Un fallo = eliminado.", 
        "ex_zombie": "Mantener inicio -> \"GO\" -> correr al objetivo. Siguiente ronda: ¡Tienes menos tiempo!", 
        "img_zombie": "",
        
        "desc_beep": "El clásico test de resistencia. Corre 20m al ritmo de las señales. La velocidad aumenta cada minuto. Calcula el VO²max.", 
        "setup_beep": "Nota: La distancia DEBE ser exactamente 20m. Elige la cantidad de jugadores.", 
        "ex_beep": "Suena la señal -> Corre al objetivo y espera. Demasiado pronto/tarde = tarjeta amarilla. ¡2ª tarjeta = eliminado!", 
        "img_beep": "",
        
        "desc_tabata": "Controlador visual y acústico para entrenamiento en grupo. Quita el cronómetro de la mano del entrenador.", 
        "setup_tabata": "Coloca los pucks en estaciones. Ajusta tiempos WORK y REST. Emite pitidos 3 segundos antes del cambio.", 
        "ex_tabata": "20s Work, 10s Rest. El anillo verde se vacía. A los 3s: Bip.. Bip.. Bip. Luego rojo respirando 10s de descanso.", 
        "img_tabata": "",
        
        "desc_react2p": "¡El duelo definitivo! Dos jugadores frente a frente. Toca tu color primero para puntuar.", 
        "setup_react2p": "Selecciona tiempo y pucks (mín. 3). Aumenta la dificultad añadiendo colores falsos.", 
        "ex_react2p": "J1 busca Rojo, J2 Azul. Los pucks se encienden -> ¡toca el tuyo lo más rápido posible!", 
        "img_react2p": "",
        
        "desc_domination": "Juego de resistencia intenso. Dos equipos luchan por el control del campo. ¡Captura y roba los pucks!", 
        "setup_domination": "Dispersa los pucks. Equipo 1 hace 1 CLIC para capturar. Equipo 2 DOBLE CLIC para robar.", 
        "ex_domination": "Equipo 1 corre y hace clic (se vuelve Rojo). Equipo 2 persigue y hace doble clic (se vuelve Azul). ¿Quién tiene más tras 2 minutos?", 
        "img_domination": "",
        
        "desc_target": "Entrena el core y el tiempo de reacción. Asistente perfecto para abdominales o planchas.", 
        "setup_target": "ABDOMINALES: Fija los pucks a la pared. Presiona en cada abdominal. Retraso de 2-3s para bajar.<br>PLANCHAS: 3 pucks en semicírculo. Levanta una mano y presiona cuando se encienda.", 
        "ex_target": "Modo Tiempo (sobrevivir 60s) o Modo Rondas (completar 30 abdominales).", 
        "img_target": "",
        
        "desc_ball": "Ejercicio de dribbling motor. Los pucks sirven como estaciones (ej. en un cuadrado).", 
        "setup_ball": "Elige pucks por estación. El jugador hace dribbling hacia el puck iluminado de su color.", 
        "ex_ball": "4 pucks en cuadrado. Un puck se enciende -> Dribla hacia él, presiona, el siguiente se enciende.", 
        "img_ball": "",
        
        "desc_batak": "Entrenamiento de reacción y visión periférica como en Fórmula 1. Una prueba de estrés para la coordinación ojo-mano.", 
        "setup_batak": "Fija los pucks separados en una pared. Se encienden brevemente. ¡Tócalos antes de que se apaguen!", 
        "ex_batak": "12 pucks en pared. 60s, modo \"Medio\". Los pucks se encienden y desaparecen tras 1.2s.", 
        "img_batak": "",
        
        "desc_ttest": "Test estándar global de agilidad. Sprints y cambios de dirección bajo presión.", 
        "setup_ttest": "SETUP: 4 pucks en forma de T.<br>1/4 anillo: Inicio (A)<br>2/4: Centro (B, a 10m de A)<br>3/4: Izquierda (C, a 5m de B)<br>4/4: Derecha (D, a 10m de C)", 
        "ex_ttest": "Sprint A hacia B -> Pasos laterales a C -> Pasos laterales a D -> Pasos laterales a B -> Carrera de espaldas a A.", 
        "img_ttest": "",
        
        "desc_sorting": "Divide de forma justa y divertida a un grupo grande de jugadores en equipos.", 
        "setup_sorting": "Elige el número de casas (grupos), jugadores totales, y cuántos pucks actúan como \"sombrero seleccionador\".", 
        "ex_sorting": "20 alumnos, 4 casas. El algoritmo garantiza exactamente 5 alumnos por casa.", 
        "img_sorting": "game_sorting.jpg",
        
        "desc_bomb": "Tic... Tac... ¿Sabes calcular el tiempo? ¡Desactiva la bomba en el momento exacto!", 
        "setup_bomb": "Elige tiempo (ej. 5s), dificultad (tolerancia) y rondas.", 
        "ex_bomb": "El puck parpadea 5x (=5s). Luego silencio. ¡Presiona exactamente a los 5s! Verde = Desactivado, Rojo = BOOM.", 
        "img_bomb": "game_bomb.jpg",
        
        "desc_memory": "¡Gimnasia mental! Entrena la memoria de trabajo espacial bajo carga física (Dual-Tasking).", 
        "setup_memory": "Dispersa los pucks. Muestran pares de colores, luego se vuelven neutros. ¡Encuentra las parejas!<br><b>Modo Búsqueda:</b> Sin colores iniciales.", 
        "ex_memory": "Corre a un puck neutro, presiona -> Se vuelve Rojo. Recuerda dónde estaba el otro. ¡Pareja = Verde!", 
        "img_memory": "",
        
        "desc_redgreen": "¡El clásico! Verde = Correr, Rojo = Congelarse. Alcanza el puck en verde para puntuar. Tocar en rojo penaliza.", 
        "setup_redgreen": "Elige número de grupos. Cada grupo tiene su propio ritmo.", 
        "ex_redgreen": "Verde -> ¡Corre rápido! Rojo -> ¡Congélate inmediatamente! Solo presiona en verde.", 
        "img_redgreen": "",
        
        "desc_pacemaker": "¡Pacing perfecto! Los pucks actúan como una \"liebre\" virtual indicando la velocidad exacta.", 
        "setup_pacemaker": "Coloca los pucks a una distancia fija (ej. 10m). Bajan su brillo 1s antes de que debas estar ahí. ¡No presiones, solo corre!", 
        "ex_pacemaker": "Ajustado a 5:00 min/km. ¡Llega al puck exactamente cuando se apague la luz!", 
        "img_pacemaker": "",
        
        "desc_hunt": "¡Caza tu color en círculo! Cognición y cambios de dirección rápidos.", 
        "setup_hunt": "Mín. 3 pucks en círculo. Un puck de tu color se enciende -> tócalo -> uno nuevo se enciende al instante.", 
        "ex_hunt": "Rojo se enciende atrás izq. -> ¡sprint y toque! ¿Quién atrapa más en 60s?", 
        "img_hunt": "",
        
        "desc_display": "Modo simple para controlar todos los pucks y reproducir efectos visuales.", 
        "setup_display": "Los pucks se pueden controlar individualmente o todos a la vez.", 
        "ex_display": "Llamativo. ¡A los niños les encantan las luces parpadeantes!", 
        "img_display": "game_display.jpg",

