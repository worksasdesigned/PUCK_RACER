        // --- HELP TEXTS (EN) ---
        "desc_stopwatch": 'A simple stopwatch. Every puck acts as its own stopwatch. The trainer can start all pucks via "Central Start". Features a "Hold Button + Countdown" mode with false start detection.<br><b>Lap Mode:</b> Click records a lap. Double-click or 0.5s hold stops the time.', 
        "setup_stopwatch": 'Select player count and mode.', 
        "ex_stopwatch": 'Set to 3 players, no further settings. Each puck is a stopwatch. 1st press = Start, 2nd = Stop.', 
        "img_stopwatch": 'game_stopwatch.jpg',
        
        "desc_timer": 'A practical tool for teaching. Each puck serves as a personal countdown timer for a student.', 
        "setup_timer": 'Set base time. Pucks light up fully and the circle depletes like an hourglass. When a student is done, they press their puck. You see immediately who finished. Add/subtract time via app.', 
        "ex_timer": 'Ideal for circuit training, quiet work, vocabulary tests, or station timers.', 
        "img_timer": '',
        
        "desc_countdown": 'Start with a number and count down to zero. Visualized via LED ring. More of a training tool than a game.', 
        "setup_countdown": 'Choose starting number (1-100). Option: Stop on first winner.', 
        "ex_countdown": 'Set to 30. Who can do 30 push-ups first (pressing the puck each time)?', 
        "img_countdown": 'game_countdown.jpg',
        
        "desc_whac": 'The ultimate reaction and cognitive drill. Pucks spawn randomly. Find the valid colors and ignore the wrong ones!', 
        "setup_whac": 'Choose up to 3 groups. Define game colors and select which ones are valid targets. 5 difficulty levels (from endless to hardcore memory).', 
        "ex_whac": 'Level 4: Pucks light up in all colors but rotate every 1.5s! Stay focused and only hit your target color. Fair highscore via "Hits per 10s".', 
        "img_whac": '',
        
        "desc_counter": 'A training support tool. Simply counts how often a player presses their puck. (min 0.3s between inputs!)', 
        "setup_counter": '1 Puck per player. Adjustable time limit.', 
        "ex_counter": 'A child does an exercise, runs back, hits the puck, and repeats. Who has the most points after 3 minutes?', 
        "img_counter": 'game_simple_counter.jpg',
        
        "desc_shuttle": 'Classic endurance test. Run back and forth between start and target.', 
        "setup_shuttle": '2 Pucks per player. Start puck shows a running light, target breathes. Start: Hold pucks until the GO signal! False start detection active.', 
        "ex_shuttle": 'Hold start -> "GO" -> run to target & press -> run back to start & press.', 
        "img_shuttle": 'game_shuttle_run.jpg',
        
        "desc_simon": 'Remember the color pattern! The computer shows it, you repeat it.', 
        "setup_simon": 'Up to 3 groups parallel. Choose pucks per group. Each puck has a color. Adjustable sequence length. Auto-restart available.', 
        "ex_simon": 'Red blinks -> Press Red. Round 2: Red, Blue blinks -> Press Red, Blue...', 
        "img_simon": 'game_simon.jpg',
        
        "desc_simonruns": 'Remember the pattern! Run to the pucks and press them. Simon says, but with sweating!<br><b>Special: Group Mode</b><br>There is only one display puck, all groups solve the same sequence. Moves to the next round once all groups finish.', 
        "setup_simonruns": 'Up to 3 groups. Choose pucks per group. Each puck has a color. Adjustable sequence length.', 
        "ex_simonruns": 'Red blinks -> Run to Red, press it! Run back to display. Round 2: Red, Blue -> Run to Red, then Blue, then back...', 
        "img_simonruns": 'game_simonruns.jpg',
        
        "desc_zombie": 'Repeated sprints with decreasing time limits. Fail to make it in time, and you are out (bitten)!', 
        "setup_zombie": 'Set start time (e.g. 10s) and reduction per round (e.g. 0.5s).<br><b>Auto-Reduce:</b> Time drops automatically after a successful run.<br><b>Sudden Death:</b> One fail = out.<br><b>Group Start:</b> All lanes start synchronously.', 
        "ex_zombie": 'Hold start -> "GO" -> run to target. Next round: You have less time!', 
        "img_zombie": '',
        
        "desc_beep": 'The classic endurance test. Run 20m in rhythm with the signals. Speed increases every minute. Calculates VO²max.', 
        "setup_beep": 'Note: Distance between start and target MUST be exactly 20m. Choose player count. Start puck shows a circular effect, target breathes.', 
        "ex_beep": 'Signal sounds -> Run to target and wait for next signal. Too early/late gives a yellow card. Second card = eliminated!', 
        "img_beep": '',
        
        "desc_tabata": 'Visual and acoustic controller for group training (e.g. circuit training). Takes the stopwatch out of the trainer\'s hand.', 
        "setup_tabata": 'Place pucks at stations. Set WORK and REST times. Pucks light up and ring depletes during work. Beeps 3 seconds before switching.', 
        "ex_tabata": '20s Work, 10s Rest. Pucks show depleting green ring. At 3s: Beep.. Beep.. Beep. Then red breathing for 10s rest.', 
        "img_tabata": '',
        
        "desc_react2p": 'The ultimate duel! Two players face each other, a row of pucks between them. Hit your color first to score. Improves reaction & cognition.', 
        "setup_react2p": 'Select time and pucks per group (min 3). Increase difficulty by assigning multiple colors per player or adding fake colors.', 
        "ex_react2p": 'Pucks on the floor. P1 looks for Red, P2 looks for Blue. Pucks light up -> hit yours as fast as possible!', 
        "img_react2p": '',
        
        "desc_domination": 'Intense endurance game. Two teams fight for control over the field. Capture pucks and steal them from the opponent!', 
        "setup_domination": 'Scatter pucks on the field. Team 1 clicks ONCE to capture. Team 2 DOUBLE-CLICKS to steal. Trainer monitors possession on screen.', 
        "ex_domination": 'Scatter many pucks. Team 1 runs and clicks (turns Red). Team 2 chases and double-clicks red pucks (turns Blue). Who has more after 2 minutes?', 
        "img_domination": '',
        
        "desc_target": 'Trains core stability and reaction time. Perfect assistant for sit-ups or planks.', 
        "setup_target": 'SIT-UPS: Attach pucks to the wall. Press a lit puck on every sit-up. Set pause delay to 2-3s to allow rolling back down.<br>PLANKS: Place 3 pucks in a semicircle. When a puck lights up, lift one hand, press it, and return to plank. Sequence or Random mode.', 
        "ex_target": 'Choose Time mode (e.g. survive 60s) or Rounds mode (e.g. complete 30 sit-ups).', 
        "img_target": '',
        
        "desc_ball": 'Motor dribbling drill. Place pucks as stations (e.g. in a square). Player dribbles to the lit puck.', 
        "setup_ball": 'Choose pucks per station (3-5) and group count. App shows optimal geometric layout. Player dribbles to the lit puck of their color.', 
        "ex_ball": 'Set 4 pucks per group. Arrange as a square. One puck lights up -> Dribble to it, press it, next one lights up.', 
        "img_ball": '',
        
        "desc_batak": 'Reaction and peripheral vision training like in Formula 1. A stress test for hand-eye coordination.', 
        "setup_batak": 'Mount pucks wide on a wall or scatter on the floor. Pucks light up randomly and briefly. Hit them before they fade! Post-game screen shows reaction times per puck.', 
        "ex_batak": 'Mount 12 pucks on a wall. Set 60s and "Medium". Pucks light up and vanish after 1.2s. Frequency increases rapidly over 60s.', 
        "img_batak": '',
        
        "desc_ttest": 'A global standard test for agility. Trains sprints and multi-directional changes under time pressure.', 
        "setup_ttest": 'SETUP: Place 4 pucks in a T-Shape. Screen helps with placement:<br>1/4 ring: Start (A)<br>2/4 ring: Center (B, 10m from A)<br>3/4 ring: Left (C, 5m from B)<br>4/4 ring: Right (D, 10m from C)<br>RECOMMENDED: Enable "Puck Press" to force players into a squat.', 
        "ex_ttest": 'Sprint A to B -> Side-step to C -> Side-step to D -> Side-step back to B -> Backpedal to A.', 
        "img_ttest": '',
        
        "desc_sorting": '"Not Slytherin, not Slytherin..." – Leave nothing to chance, but keep control! Fairly divides a large group of players into equal teams.', 
        "setup_sorting": 'Choose number of houses (groups), total players, and how many pucks act as "sorting hats".', 
        "ex_sorting": '20 students, 4 houses. Algorithm guarantees exactly 5 students per house.', 
        "img_sorting": 'game_sorting.jpg',
        
        "desc_bomb": 'Tick... Tock... Can you estimate time? Defuse the bomb at the exact right moment!', 
        "setup_bomb": 'Choose time (e.g. 5s), difficulty (tolerance), and rounds.', 
        "ex_bomb": 'Puck blinks 5x (=5s). Then countdown. Then silence. Press exactly after 5 seconds! Green = Defused, Red = BOOM.', 
        "img_bomb": 'game_bomb.jpg',
        
        "desc_memory": 'Brain jogging! Trains spatial working memory under physical load (Dual-Tasking).', 
        "setup_memory": 'Scatter pucks over a large area. Choose difficulty (color display time). Pucks show color pairs, then go neutral. Find and press the matching pairs!<br><b>Search Mode:</b> Pucks show no initial colors (hidden memory).', 
        "ex_memory": 'Run to a neutral puck, press it -> Turns Red. Remember where the other red puck was, sprint there, press it. Match = Green!', 
        "img_memory": '',
        
        "desc_redgreen": 'The classic! Pucks indicate: Run (Green) or Freeze (Red). Reach the puck on Green to score. Pressing on Red gives a penalty.', 
        "setup_redgreen": 'Choose group count. Each group has its own rhythm.', 
        "ex_redgreen": 'Green -> Run fast! Red -> Freeze immediately! Only press when Green.', 
        "img_redgreen": '',
        
        "desc_pacemaker": 'Trains perfect pacing! Pucks act as a virtual "rabbit" showing the exact running speed.', 
        "setup_pacemaker": 'Place pucks at set distances (e.g. 10m) in a circle or straight line (Shuttle Mode). Pucks dim down and show a countdown 1s before you need to be there. Do not press the pucks, just focus on running!', 
        "ex_pacemaker": 'Set 5:00 min/km and 10m distance. Light travels exactly at 12 km/h. Be at the puck exactly when the light goes out!', 
        "img_pacemaker": '',
        
        "desc_hunt": 'Hunt your own color in a circle! Cognition, peripheral vision, and rapid directional changes.', 
        "setup_hunt": 'Place min. 3 pucks in a circle. Each player gets a color. A puck lights up in your color -> hit it -> a new one lights up instantly.<br><b>Difficulty:</b> Higher levels mean pucks disappear faster. Missing a puck adds a penalty second.', 
        "ex_hunt": 'Red lights up back left -> sprint & press! Instantly, Red lights up front right. Who catches the most in 60s?', 
        "img_hunt": '',
        
        "desc_display": 'Simple display mode to control all pucks and play visual effects.', 
        "setup_display": 'Pucks can be controlled individually or all together.', 
        "ex_display": 'Eye-catcher. Kids love blinking lights!', 
        "img_display": 'game_display.jpg',

