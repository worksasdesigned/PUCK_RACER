    de: {
        // --- GLOBAL UI ---
        "btn_back": "⬅ ZURÜCK",
        "btn_next": "WEITER ➡",
        "btn_cancel": "Abbrechen",
        "btn_start_game": "ZUM SPIEL 🏁",
        "btn_start": "START",
        "btn_stop": "STOPP",
        "btn_reset": "NEUSTART",
        "btn_home": "🏠 Startseite",
        "btn_running": "Läuft...",
        "btn_start_all": "ALLE STARTEN",
        "btn_stop_all": "ALLE STOPPEN",
        "lbl_time_limit": "Zeitlimit:",
        "loading": "Lädt...",
        "loading_pucks": "Suche Pucks...",
        "conn_pucks": "Verbundene Pucks:",
        "req_pucks": "Benötigt:",
        "lbl_done": "FERTIG",
		"filter_fav": "⭐ Favoriten",

        // --- DASHBOARD (index.html) ---
        "filter_all": "Alle Spiele", 
        "filter_reaction": "Reaktion", 
        "filter_brain": "Gehirn & Memory", 
        "filter_sport": "Workout", 
        "filter_tools": "Werkzeuge",
        "help_desc": "Beschreibung", 
        "help_setup": "Aufbau", 
        "help_example": "Beispiel",
        "g_counter": "Einfacher Zähler", "g_timer": "Einfacher Timer", "g_stopwatch": "Stoppuhr", "g_countdown": "Countdown",
        "g_shuttle": "Pendellauf", "g_simon": "Simon Says", "g_simonruns": "Simon Runs", "g_zombie": "Zombie Escape",
        "g_whac": "Whac-A-Mole", "g_sorting": "Der Sprechende Hut", "g_bomb": "Bomb Squad", "g_redgreen": "Ochs am Berg",
        "g_beep": "Luc Léger (Beep Test)", "g_react2p": "React 2-Spieler ⚡", "g_target": "Target Touch", "g_ball": "Ball Prellen",
        "g_ttest": "Agilitäts T-Test", "g_hunt": "Hunt! (Farbenjagd)", "g_pacemaker": "Der Pacemaker", "g_memory": "Memory Sprint",
        "g_domination": "Domination", "g_batak": "Batak Pro", "g_tabata": "Zirkeltraining", "g_display": "Display Modus", "g_settings": "Einstellungen",

        // --- HELP TEXTS (DE) ---
        "desc_stopwatch": 'Eine einfache Stoppuhr. Jeder Puck agiert als eigene Stoppuhr. Der Trainer kann mit "Central Start" alle gleichzeitig starten, für Wettrennen gibt es einen "Hold Button + Countdown" Mode mit Frühstart Erkennung.<br><b>Rundenmodus:</b> Der Puck registriert beim Drücken eine Runde. Doppelklick oder 0.5 Sekunden halten stoppt die Stoppuhr.', 
        "setup_stopwatch": 'Anzahl Spieler und Spielmodus wählen.', 
        "ex_stopwatch": 'Stelle 3 Spieler ein und keine weiteren Settings. Jeder Puck ist jetzt eine einfache Stoppuhr. Erstes Drücken = Start, zweites Drücken = Stop.', 
        "img_stopwatch": 'game_stopwatch.jpg',
        
        "desc_timer": 'Ein praktisches Werkzeug für den Unterricht. Jeder Puck dient als persönliche Countdown-Eieruhr für einen Schüler.', 
        "setup_timer": 'Stelle die Basiszeit ein. Die Pucks leuchten voll auf und der Kreis leert sich wie eine Sanduhr. Ist ein Schüler fertig, drückt er seinen Puck. Du siehst sofort auf dem Bildschirm, wer fertig ist. Du kannst einzelnen Schülern jederzeit per Knopfdruck Zeit abziehen oder hinzufügen.', 
        "ex_timer": 'Ideal für Zirkeltraining, Stillarbeit, Vokabeltests oder als Stationsuhr.', 
        "img_timer": '',
        
        "desc_countdown": 'Starte mit einer Zahl und zähle runter auf Null. Visualisierung über LED-Ring. Eher allgemeine Trainingsunterstützung als ein Spiel.', 
        "setup_countdown": 'Startzahl wählen (1-100). Option: Spiel stoppt beim ersten Gewinner.', 
        "ex_countdown": 'Stelle 30 ein. Wer schafft zuerst 30 Liegestütze (jedes Mal drücken)?', 
        "img_countdown": 'game_countdown.jpg',
        
        "desc_whac": 'Das ultimative Reaktions- und Kognitions-Spiel. Pucks spawnen zufällig. Finde die gültigen Farben und ignoriere die falschen!', 
        "setup_whac": 'Wähle bis zu 3 Gruppen. Definiere die Farben im Spiel und wähle anschließend aus, welche dieser Farben gedrückt werden dürfen. 5 Schwierigkeitsgrade (von Endlos bis Hardcore Memory).', 
        "ex_whac": 'Level 4: Die Pucks leuchten in allen Farben auf, wechseln aber nach 1.5 Sekunden rotierend durch! Bleib fokussiert und drücke nur deine Ziel-Farbe. Fairer Highscore durch "Hits pro 10s" Anzeige.', 
        "img_whac": '',
        
        "desc_counter": 'Eher eine Trainingsunterstützung als ein Spiel. Zählt einfach, wie oft ein Spieler seinen Puck drückt. (min 0.3 Sekunden zwischen den Impulsen!)', 
        "setup_counter": '1 Puck pro Spieler. Zeitlimit einstellbar.', 
        "ex_counter": 'Ein Kind macht eine Übung (z.B. über Bank ziehen), rennt zurück, drückt den Puck, und wiederholt die Übung. Wer hat nach 3 Minuten die meisten Punkte?', 
        "img_counter": 'game_simple_counter.jpg',
        
        "desc_shuttle": 'Klassischer Ausdauer-Test. Laufe zwischen Start und Ziel hin und her.', 
        "setup_shuttle": '2 Pucks pro Spieler. Der Start-Puck zeigt ein Lauflicht, der Ziel-Puck "atmet". Start: Pucks gedrückt halten bis zum GO Signal! Fehlstart-Erkennung aktiv. Einfach wieder drauf drücken um den Countdown erneut zu starten.', 
        "ex_shuttle": 'Start halten -> "GO" -> zu Ziel rennen & drücken -> zurück zu Start rennen & drücken.', 
        "img_shuttle": 'game_shuttle_run.jpg',
        
        "desc_simon": 'Merk dir das Farbmuster! Der Computer zeigt es, du machst es nach.', 
        "setup_simon": 'Bis zu 3 Gruppen parallel. Wähle die Anzahl Pucks pro Gruppe. Jeder Puck hat eine Farbe. Du kannst die Sequenzlänge einstellen. Autostart startet das Spiel je Gruppe neu.', 
        "ex_simon": 'Rot blinkt -> Drücke Rot. 2. Runde: Rot, Blau blinkt -> Drücke Rot, Blau...', 
        "img_simon": 'game_simon.jpg',
        
        "desc_simonruns": 'Merk dir das Farbmuster! Renn zu den Pucks und drücke sie. Simon says, aber mit Schwitzen!<br><b>Sonderfall: Gruppenmodus</b><br> Es gibt nur einen Anzeigepuck und alle Gruppen lösen die gleiche Sequenz. Es geht erst weiter wenn alle Gruppen die Sequenz gelöst haben.', 
        "setup_simonruns": 'Bis zu 3 Gruppen parallel. Wähle die Anzahl Pucks pro Gruppe. Jeder Puck hat eine Farbe. Einstellbare Sequenzlänge.', 
        "ex_simonruns": 'Rot blinkt -> Renne zu Rot und drücke Rot. Renne zurück zum Anzeigepuck. 2. Runde: Rot, Blau blinkt -> Renne zu Rot, dann zu Blau, dann zurück...', 
        "img_simonruns": 'game_simonruns.jpg',
        
        "desc_zombie": 'Wiederholende Sprints mit ständig verkürzter Zeit. Wer es nicht schafft, wird vom Zombie gebissen und ist raus!', 
        "setup_zombie": 'Stelle die Startzeit (z.B. 10s) und die Zeit-Reduktion pro Durchgang (z.B. 0.5s) ein.<br><b>Auto-Verkürzung:</b> Zeit wird automatisch reduziert.<br><b>Sudden Death:</b> Ein Fehler = raus.<br><b>Gruppenstart:</b> Alle Bahnen warten aufeinander.', 
        "ex_zombie": 'Startknopf halten -> "GO" -> Zum Ziel rennen. Nächste Runde: Du hast weniger Zeit!', 
        "img_zombie": '',
        
        "desc_beep": 'Der klassische Ausdauertest. Renne 20m Distanz im Rhythmus der Signale. Das Tempo steigert sich minütlich. Ziel ist die VO²max Ermittlung.', 
        "setup_beep": 'Achtung: Die Distanz zwischen Start und Ziel muss exakt 20m betragen. Wähle die Anzahl der Läufer. Der Start-Puck zeigt einen Kreis Effekt, der Ziel-Puck "atmet".', 
        "ex_beep": 'Signal ertönt -> Renne zum Ziel und warte auf das nächste Signal. Bist du zu früh oder zu spät, gibt es eine Gelbe Karte. Bei der zweiten fliegst du raus!', 
        "img_beep": '',
        
        "desc_tabata": 'Ein visuelles und akustisches Steuerungssystem für das Gruppentraining (z.B. Zirkeltraining). Nimmt dem Trainer die Stoppuhr ab.', 
        "setup_tabata": 'Die Pucks werden bei den verschiedenen Zirkel-Stationen platziert. Stelle die Belastungsdauer und die Pausenzeit ein. Die Pucks leuchten voll auf und der Kreis leert sich während der Übung. 3 Sekunden vor dem Wechsel piepen sie zur Vorwarnung.', 
        "ex_tabata": '20s Belastung, 10s Pause. Pucks zeigen einen ablaufenden grünen Ring. Bei 3s Rest: Beep.. Beep.. Beep. Dann rotes Atmen für 10 Sekunden Pause.', 
        "img_tabata": '',
        
        "desc_react2p": 'Das ultimative Duell! Zwei Spieler stehen sich gegenüber, zwischen Ihnen eine Reihe Pucks. Wer den Puck in seiner Farbe zuerst drückt, bekommt den Punkt. Ziel: Reaktion und kognitive Fähigkeiten verbessern.', 
        "setup_react2p": 'Wähle die Spielzeit und die Anzahl Pucks pro Gruppe (mind. 3). Zur Erhöhung der Schwierigkeit kannst du jedem Spieler bis zu 3 Farben geben oder Fake-Farben zuschalten.', 
        "ex_react2p": 'Pucks liegen auf dem Boden. Spieler 1 sucht Rot, Spieler 2 sucht Blau. Pucks leuchten auf -> so schnell wie möglich draufschlagen!', 
        "img_react2p": '',
        
        "desc_domination": 'Intensives Ausdauerspiel. Zwei Teams kämpfen um die Vorherrschaft auf dem Spielfeld. Erobert Pucks durch Klicken und klaut sie dem Gegner!', 
        "setup_domination": 'Die Pucks werden frei auf dem Feld verteilt. Team 1 klickt Pucks EINMAL, um sie zu erobern. Team 2 macht auf dem gleichen Puck einen DOPPELKLICK, um ihn zu stehlen. Trainer kann im Screen sehen, wer was besitzt.', 
        "ex_domination": 'Lege möglichst viele Pucks in die Halle. Team 1 rennt los und klickt Pucks an (werden Rot). Team 2 rennt hinterher und macht Doppelklicks auf die roten Pucks (werden Blau). Wer hat nach 2 Minuten die meisten?', 
        "img_domination": '',
        
        "desc_target": 'Trainiert die Rumpfstabilität und Reaktionszeit. Perfekt als intelligenter Helfer für Sit-ups oder den Unterarmstütz (Plank).', 
        "setup_target": 'SIT-UPS: Befestige die Pucks an der Wand (oder lege sie an die Füße). Bei jedem Aufrollen musst du den leuchtenden Puck drücken. Setze die "Pausenzeit" auf 2-3 Sekunden, damit du Zeit hast, wieder abzurollen.<br>PLANKS: Lege 3 Pucks im Halbkreis vor dich. Gehe in den Unterarmstütz. Leuchtet ein Puck, musst du eine Hand lösen, den Puck drücken und den Arm wieder aufsetzen.', 
        "ex_target": 'Modus wählbar auf Zeit (z.B. 60s durchhalten) oder auf Ziel-Runden (z.B. 30 Sit-ups absolvieren).', 
        "img_target": '',
        
        "desc_ball": 'Motorisches Dribbling-Training. Die Pucks werden als Stationen (z.B. im Quadrat) aufgebaut. Der Spieler prellt den Ball zum leuchtenden Puck.', 
        "setup_ball": 'Wähle die Pucks pro Station (3 bis 5) und die Anzahl der Spieler-Gruppen. Die App zeigt den optimalen geometrischen Aufbau an. Jeder Spieler prellt zum leuchtenden Puck seiner Farbe.', 
        "ex_ball": 'Stelle 4 Pucks pro Gruppe ein. Baue sie als Quadrat auf. Ein Puck leuchtet. Dribble hin, drücke ihn, der nächste leuchtet auf. Der Trainer kann jede Gruppe einzeln starten oder stoppen.', 
        "img_ball": '',
        
        "desc_batak": 'Reaktion und Peripheres Sehen wie in der Formel 1. Ein Stresstest für die Auge-Hand-Koordination.', 
        "setup_batak": 'Die Pucks werden breitflächig an einer Wand befestigt oder auf dem Boden verteilt. Pucks leuchten zufällig, kurz und überlappend auf. Triff sie, bevor sie erlöschen! Auf der Auswertungsseite siehst du für jeden einzelnen Puck deine Reaktionszeit.', 
        "ex_batak": 'Befestige 12 Pucks an einer Wand. Stelle 60s und "Mittel" ein. Pucks leuchten auf und verschwinden nach 1,2 Sekunden wieder. Die Aufleucht-Frequenz steigert sich im Laufe der 60 Sekunden rasant.', 
        "img_batak": '',
        
        "desc_ttest": 'Ein weltweiter Standardtest zur Messung der Agilität. Trainiert Sprints und schnelle, multidirektionale Richtungswechsel unter Zeitdruck.', 
        "setup_ttest": 'AUFBAU: 4 Pucks in T-Form. Im Namens-Screen leuchten die Pucks als Hilfe:<br>1/4 Ring: Start (A)<br>2/4 Ring: Mitte (B, 10m vom Start)<br>3/4 Ring: Links (C, 5m von Mitte)<br>4/4 Ring: Rechts (D, 10m von Links)<br>EMPFOHLEN: "Puck Press" aktivieren (zwingt Spieler in die Hocke).', 
        "ex_ttest": 'Sprint A nach B -> Side-Steps nach C -> Side-Steps nach D -> Side-Steps zurück nach B -> Rückwärtslaufen ins Ziel A.', 
        "img_ttest": '',
        
        "desc_sorting": '"Nicht Slytherin, nicht Slytherin..." – Überlasse dem Zufall keine Chance, aber behalte die Kontrolle! Dieses Tool teilt eine große Menge Spieler absolut fair und zufällig in gleich große Gruppen ein.', 
        "setup_sorting": 'Wähle die Anzahl der Gruppen (Häuser), die Gesamtanzahl der Spieler und wie viele Pucks als "Verteiler" dienen sollen.', 
        "ex_sorting": '20 Schüler, 4 Häuser. Der Algorithmus garantiert, dass am Ende exakt 5 Schüler in jedem Haus sind. Das System zeigt bei Abbruch an, wie auszugleichen ist.', 
        "img_sorting": 'game_sorting.jpg',
        
        "desc_bomb": 'Tick... Tack... Kannst du die Zeit einschätzen? Entschärfe die Bombe im richtigen Moment!', 
        "setup_bomb": 'Wähle Zeit (z.B. 5s), Schwierigkeit (Toleranz) und Rundenanzahl.', 
        "ex_bomb": 'Puck blinkt 5x (=5s). Dann Countdown. Dann Stille. Drücke genau nach 5 Sekunden! Grün = Entschärft, Rot = BOOM. Die Schwierigkeit gibt das Toleranzzeitfenster vor.', 
        "img_bomb": 'game_bomb.jpg',
        
        "desc_memory": 'Gehirnjogging! Trainiert das räumliche Arbeitsgedächtnis unter körperlicher Belastung (Dual-Tasking).', 
        "setup_memory": 'Die Pucks werden wild auf einer großen Fläche verstreut. Wähle die Schwierigkeit (Anzeigezeit der Farben). Nach dem Start zeigen alle Pucks kurz ihr Farbpärchen, danach werden sie neutral. Finde und drücke die passenden Pärchen!<br><b>Search Mode:</b> Pucks zeigen am Anfang keine Farben.', 
        "ex_memory": 'Renne zu neutralem Puck, drücke ihn -> Er wird Rot. Erinnere dich, wo der zweite Rote war, sprinte dorthin und drücke. Stimmt das Paar, leuchten sie grün!', 
        "img_memory": '',
        
        "desc_redgreen": 'Der Klassiker! Die Pucks zeigen an: Laufen (Grün) oder Stehen (Rot). Wer bei Grün ankommt und drückt, kriegt einen Punkt. Wer bei Rot drückt, wird bestraft (rotes Blinken + Ton).', 
        "setup_redgreen": 'Wähle die Anzahl der Gruppen. Jede Gruppe hat ihren eigenen Rhythmus.', 
        "ex_redgreen": 'Grün -> Schnell rennen! Rot -> Sofort einfrieren! Drücken nur wenn es Grün ist.', 
        "img_redgreen": '',
        
        "desc_pacemaker": 'Trainiert das perfekte Pacing! Die Pucks geben als virtueller "Hase" exakt die Geschwindigkeit vor, die gelaufen werden soll.', 
        "setup_pacemaker": 'Pucks im vorgegebenen Abstand (z. B. alle 10 Meter) in einem Kreis oder auf einer geraden Strecke (Shuttle) auslegen. Die Pucks dimmen sich automatisch und zeigen eine Sekunde bevor du dort sein musst, einen Countdown. Nicht drücken, nur mitlaufen!', 
        "ex_pacemaker": 'Stelle 5:00 min/km und 10 Meter Abstand ein. Ein Licht wandert nun exakt mit 12 km/h von Puck zu Puck. Sei immer genau dann am Puck, wenn er erlischt!', 
        "img_pacemaker": '',
        
        "desc_hunt": 'Jage im Kreis deine eigene Farbe! Kognition, periphere Sicht und schnelle Richtungswechsel unter Zeitdruck.', 
        "setup_hunt": 'Die Pucks (mind. 3) werden im Kreis um die Spieler aufgebaut. Jeder Spieler bekommt eine Farbe. Startet das Spiel, leuchtet für jeden Spieler irgendwo ein Puck auf. Drückt er ihn, leuchtet woanders ein neuer auf.<br><b>Schwierigkeit:</b> Je höher, desto schneller verschwinden die Pucks.', 
